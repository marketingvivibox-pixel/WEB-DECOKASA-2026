{% assign is_demo = false %}
{% render 'product-landing', product: product, section: section, is_demo: is_demo, routes: routes %}
{% assign related = product.collections.first | default: collections.all %}
{% if related.products.size < 2 %}{% assign related = collections.all %}{% endif %}
{% if related.products.size > 1 %}
  {% capture related_track %}Related-{{ section.id }}{% endcapture %}
  <section class="wrap interface-related" data-carousel aria-labelledby="RelatedTitle-{{ section.id }}">
    <div class="interface-section-heading"><h2 id="RelatedTitle-{{ section.id }}">También te puede interesar</h2><a href="{{ routes.all_products_collection_url }}">Ver catálogo {% render 'icon', name: 'arrow' %}</a></div>
    <div class="interface-track interface-product-track" id="{{ related_track }}" data-carousel-track tabindex="0" aria-label="Productos relacionados">
      {% for recommendation in related.products limit: 9 %}
        {% unless recommendation.id == product.id %}{% render 'product-card', product: recommendation, demo: is_demo, settings: settings, custom_color_swatches: section.settings.custom_color_swatches %}{% endunless %}
      {% endfor %}
    </div>
    {% render 'storefront-carousel-controls', track_id: related_track %}
  </section>
{% endif %}
{% schema %}
{
  "name": "Ficha de producto",
  "settings": [
    {"type": "header", "content": "Galería"},
    {"type": "select", "id": "gallery_ratio", "label": "Formato de la imagen", "options": [{"value": "responsive", "label": "Adaptable a la pantalla"}, {"value": "square", "label": "Cuadrado"}, {"value": "portrait", "label": "Vertical"}], "default": "responsive"},
    {"type": "select", "id": "image_fit", "label": "Ajuste de las fotos", "options": [{"value": "contain", "label": "Mostrar foto completa"}, {"value": "cover", "label": "Rellenar el espacio"}], "default": "contain"},
    {"type": "header", "content": "Información"},
    {"type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": true},
    {"type": "checkbox", "id": "show_sku", "label": "Mostrar SKU", "default": true},
    {"type": "checkbox", "id": "show_price", "label": "Mostrar precio del producto", "default": true},
    {"type": "checkbox", "id": "show_compare_price", "label": "Mostrar precio de comparación", "default": true},
    {"type": "text", "id": "price_note", "label": "Nota bajo el precio", "default": "El asesor confirmará el importe final y la entrega."},
    {"type": "paragraph", "content": "La meta del regalo se calcula automáticamente: precio de la presentación más cara × 1.80 (80% adicional)."},
    {"type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Solicitar compra"},
    {"type": "checkbox", "id": "show_description", "label": "Mostrar descripción del producto", "default": true},
    {"type": "header", "content": "Muestras de color"},
    {"type": "textarea", "id": "custom_color_swatches", "label": "Tonos exactos de color", "info": "Define el tono exacto para nombres de color. Formato: Nombre = #hex (uno por línea). Ej: Gris Claro = #d4d4d8, Gris oscuro = #4b5563.", "default": "Gris Claro = #d4d4d8\nGris oscuro = #4b5563"}
  ],
  "blocks": [{"type": "information", "name": "Información desplegable", "settings": [{"type": "text", "id": "heading", "label": "Título", "default": "Información de entrega"}, {"type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Consulta las condiciones de entrega con tu asesor.</p>"}]}],
  "max_blocks": 6,
  "presets": [{"name": "Ficha de producto"}]
}
{% endschema %}
