{{ 'landing-piso-spc.css' | asset_url | stylesheet_tag }}
{{ 'landing-piso-spc-proportions.css' | asset_url | stylesheet_tag }}
{{ 'landing-piso-spc-layout.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-piso-spc.js' | asset_url }}" defer></script>
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_name = product.title | default: 'Piso SPC'
  assign phone = section.settings.whatsapp_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign contact_message = 'Hola, quiero asesoría sobre ' | append: product_name | append: ' de Decokasa.' | url_encode
  assign contact_url = 'https://wa.me/' | append: phone | append: '?text=' | append: contact_message
  assign colors_id = 'spc-colores-' | append: section.id
  assign catalog_url = section.settings.catalog_url
  if catalog_url == blank
    assign catalog_url = '#' | append: colors_id
  endif
  assign coverage = current_variant.metafields.decokasa.coverage_m2.value | default: product.metafields.decokasa.coverage_m2.value | default: section.settings.coverage_m2 | plus: 0
%}
<div class="spc-page" data-spc-page data-phone="{{ phone | escape }}" data-product="{{ product_name | escape }}" data-sku="{{ current_variant.sku | escape }}" data-coverage="{{ coverage }}">
  {% if section.settings.spc_design_preview %}<p class="spc-preview-note">Vista de diseño · Los testimonios y sellos de esta muestra requieren validación antes de publicarse.</p>{% endif %}
  <div class="spc-canvas">
    <header class="spc-hero">
      <img class="spc-backdrop" src="{{ 'spc-sala-comedor-piso-madera-hero.webp' | asset_url }}" width="1117" height="2030" alt="" fetchpriority="high">
      {% if section.settings.show_top_announcement %}<a class="spc-announcement" href="{{ catalog_url | escape }}"><strong>¡Nuevos colores disponibles!</strong> Solicita el catálogo aquí {% render 'spc-icon', name: 'arrow' %}</a>{% endif %}
      <div class="spc-hero-heading">
        <img class="spc-symbol" src="{{ 'spc-marca-simbolo.png' | asset_url }}" width="1113" height="1097" alt="Decokasa">
        <h1>Pisos <span>SPC</span></h1><p>Los pisos del futuro</p>
      </div>
      <img class="spc-hero-product" src="{{ 'spc-caja-tres-tablones-verticales.webp' | asset_url }}" width="1515" height="2048" alt="Caja de piso SPC y tablones con acabados madera clara, gris y caoba" loading="eager">
    </header>
    <section class="spc-intro spc-rounded" aria-label="Conoce nuestros pisos SPC">
      <p class="spc-intro-copy"><strong>¡Los Pisos del Futuro ya están aquí!</strong><br>Con Sistema Click, espuma incorporada<br class="spc-desktop-break"> y de instalación rápida: ¡La mejor opción para<br class="spc-desktop-break"> revestir superficies <strong>sin gastar de más!</strong></p>
      {% render 'spc-actions', contact_url: contact_url, catalog_url: catalog_url %}
      <div class="spc-colors" id="{{ colors_id }}" aria-label="Colores de referencia del piso SPC">
        <button type="button" class="spc-color-arrow spc-color-arrow--previous" data-color-step="-1" aria-label="Ver color anterior" hidden>{% render 'spc-icon', name: 'arrow' %}</button>
        <div class="spc-color-list">
          {% assign color_codes = '001,019,007' | split: ',' %}
          {% assign color_names = 'Madera natural,Caoba,Gris claro' | split: ',' %}
          {% for code in color_codes %}{% assign swatch_file = 'spc-muestra-' | append: code | append: '.webp' %}
            <button class="spc-swatch" type="button" data-color="{{ color_names[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ swatch_file | asset_url }}" width="800" height="800" alt="" loading="lazy"><span>{{ color_names[forloop.index0] }}</span></button>
          {% endfor %}
        </div>
        <button type="button" class="spc-color-arrow" data-color-step="1" aria-label="Ver siguiente color" hidden>{% render 'spc-icon', name: 'arrow' %}</button>
      </div>
      <p class="spc-color-status" data-color-status aria-live="polite">Madera natural · Color de referencia</p>
      <p class="spc-fineprint">Para mayor información y disponibilidad, contacta con un asesor de ventas.</p>
    </section>
    <section class="spc-benefits">
      <img class="spc-backdrop" src="{{ 'spc-sala-divan-piso-gris-beneficios.webp' | asset_url }}" width="2000" height="1576" alt="" loading="lazy">
      <div class="spc-section-inner"><h2>La mejor tecnología<br><mark>en pisos flotantes</mark></h2>
        <ul class="spc-benefit-grid">
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--resistencia-agua" src="{{ 'spc-icono-resistencia-agua.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption"><strong>Resistentes</strong><br>al agua</span></li>
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--espuma-integrada" src="{{ 'spc-icono-espuma-integrada.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption">Incluyen<br><strong>espuma</strong></span></li>
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--transito-residencial" src="{{ 'spc-icono-transito-residencial.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption">Tránsito<br><strong>residencial</strong></span></li>
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--sistema-click" src="{{ 'spc-icono-sistema-click.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption">Sistema<br><strong>Click</strong></span></li>
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--facil-limpieza" src="{{ 'spc-icono-facil-limpieza.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption">Fácil de<br><strong>limpiar</strong></span></li>
      <li><span class="spc-benefit-art"><img class="spc-benefit-icon spc-benefit-icon--pet-friendly" src="{{ 'spc-icono-pet-friendly.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"></span><span class="spc-benefit-caption"><strong>Pet<br>friendly</strong></span></li>
    </ul>
      </div>
    </section>
    <section class="spc-anatomy spc-rounded">
      <img class="spc-watermark" src="{{ 'spc-marca-simbolo.png' | asset_url }}" width="1113" height="1097" alt="" loading="lazy">
      <div class="spc-anatomy-copy"><h2>Costo accesible<br><mark>Grandes beneficios</mark></h2>
        <dl class="spc-specs">
          <div><dt>Medidas</dt><dd>122 × 18 cm</dd></div><div><dt>Una caja</dt><dd>10 planchas</dd></div>
          <div><dt>Rendimiento</dt><dd>{{ coverage }} m² / caja</dd></div><div><dt>Espesor total</dt><dd>5.5 mm</dd></div>
          <div><dt>Capa de uso</dt><dd>0.3 mm</dd></div><div><dt>Espuma IXPE</dt><dd>1.5 mm</dd></div>
        </dl>
        <h3>5 capas de<br><mark>máxima resistencia</mark></h3>
        <ol class="spc-layers"><li>Protección UV</li><li>Capa de uso</li><li>Diseño decorativo</li><li>Núcleo rígido SPC</li><li>Espuma acústica IXPE</li></ol>
      </div>
      <img class="spc-layer-image" src="{{ 'spc-despiece-capas-piso.webp' | asset_url }}" width="559" height="583" alt="Despiece del piso SPC: acabado, diseño, núcleo rígido y base de espuma" loading="lazy">
      <p class="spc-fineprint">¿Necesitas más información? <a href="{{ contact_url | escape }}" target="_blank" rel="noopener">Consulta con un asesor aquí.</a></p>
    </section>
    <section class="spc-installation">
      <img class="spc-backdrop" src="{{ 'spc-instalacion-click.webp' | asset_url }}" width="1080" height="939" alt="Instalación de tablones SPC mediante sistema Click" loading="lazy">
      <div class="spc-section-inner"><h2>Calcula cuántos<br><mark>pisos necesitas</mark></h2>
        <form class="spc-calculator" data-spc-calculator>
          <label for="spc-area-{{ section.id }}">¿Cuánto mide tu espacio?</label>
          <div class="spc-input-row"><div class="spc-area-field"><input id="spc-area-{{ section.id }}" name="area" type="number" min="0.01" max="100000" step="any" inputmode="decimal" placeholder="Ej. 20" required aria-describedby="spc-calc-help-{{ section.id }} spc-calc-error-{{ section.id }}"><span>m²</span></div><button type="submit">Calcular</button></div>
          <label class="spc-waste"><input type="checkbox" name="waste" checked> Incluir 10% adicional para cortes</label>
          <p class="spc-calc-help" id="spc-calc-help-{{ section.id }}">{{ coverage }} m² por caja. Cantidad orientativa; el asesor confirma tu pedido.</p>
          <p class="spc-calc-error" id="spc-calc-error-{{ section.id }}" data-calc-error role="alert" hidden></p>
          <div class="spc-calc-result" data-calc-result aria-live="polite" hidden><p><strong data-boxes></strong><span data-covered></span></p><a data-calc-contact href="{{ contact_url | escape }}" target="_blank" rel="noopener">Consultar esta cantidad {% render 'spc-icon', name: 'arrow' %}</a></div>
          <noscript><p>Activa JavaScript para calcular o consulta la cantidad con un asesor.</p></noscript>
        </form>
        {% render 'spc-actions', contact_url: contact_url, catalog_url: catalog_url %}
      </div>
    </section>
    {% if section.blocks.size > 0 or section.settings.spc_design_preview %}
      <section class="spc-testimonials spc-rounded">
        <img class="spc-perspective" src="{{ 'spc-cuatro-muestras-perspectiva.webp' | asset_url }}" width="1014" height="796" alt="" loading="lazy">
        <div class="spc-testimonial-intro"><h2>Nuestros clientes<br><mark>nos recomiendan</mark></h2><p>Conoce las experiencias<br>con nuestro Piso SPC.</p>{% if section.settings.spc_design_preview %}<small>Contenido de muestra.<br>Pendiente de testimonios reales.</small>{% endif %}</div>
        <div class="spc-testimonial-grid">
          {% for block in section.blocks %}<figure class="spc-quote" {{ block.shopify_attributes }}>
            {% if block.settings.portrait != blank %}{{ block.settings.portrait | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.name }}{% endif %}
            <figcaption>{{ block.settings.name | escape }}</figcaption><span class="spc-stars" aria-label="5 de 5 estrellas">★★★★★</span><blockquote>{{ block.settings.quote | escape }}</blockquote>
          </figure>{% endfor %}
          {% if section.settings.spc_design_preview and section.blocks.size == 0 %}
            <figure class="spc-quote"><img src="{{ 'spc-retrato-mujer-mockup.webp' | asset_url }}" width="600" height="600" alt="Retrato de muestra del mockup" loading="lazy"><figcaption>Testimonio 01</figcaption><span class="spc-stars" aria-hidden="true">★★★★★</span><blockquote>Espacio para la experiencia de un cliente con nuestros pisos SPC.</blockquote><small>Texto de muestra</small></figure>
            <figure class="spc-quote"><img src="{{ 'spc-retrato-hombre-mockup.webp' | asset_url }}" width="600" height="600" alt="Retrato de muestra del mockup" loading="lazy"><figcaption>Testimonio 02</figcaption><span class="spc-stars" aria-hidden="true">★★★★★</span><blockquote>Espacio para una recomendación real y autorizada de nuestros clientes.</blockquote><small>Texto de muestra</small></figure>
          {% endif %}
        </div>
      </section>
    {% endif %}
    <section class="spc-showcase">
      <img class="spc-backdrop" src="{{ 'spc-sala-sofa-gris-piso-madera.webp' | asset_url }}" width="1946" height="1460" alt="Sala con sofá gris y piso con acabado de madera" loading="lazy">
      <h2>Resultados<br><mark>y testimonios</mark></h2><p class="spc-fineprint">Los colores y texturas pueden variar. Consulta las muestras con un asesor.</p>
    {% if section.settings.show_certifications or section.settings.spc_design_preview %}
      <div class="spc-seals" aria-label="{% if section.settings.spc_design_preview %}Sellos del mockup pendientes de validar{% else %}Certificaciones del producto{% endif %}">
        {% assign seals = 'eph,ilac-mra,anab,dakks,floorscore,cnas' | split: ',' %}
        {% for seal in seals %}{% assign seal_file = 'spc-sello-' | append: seal | append: '.png' %}<img src="{{ seal_file | asset_url }}" width="110" height="80" alt="{{ seal | upcase }}" loading="lazy">{% endfor %}
      </div>
    {% endif %}
    </section>
    <footer class="spc-footer spc-rounded">
      <img class="spc-wordmark" src="{{ 'spc-marca-logotipo.png' | asset_url }}" width="1529" height="348" alt="Decokasa Premium" loading="lazy">
      <img class="spc-footer-product" src="{{ 'spc-caja-tablon-diagonal.webp' | asset_url }}" width="1314" height="1077" alt="Caja Decokasa y tablón SPC con acabado de madera" loading="lazy">
      <div class="spc-footer-copy"><h2>Acabados<br><mark>100% Premium</mark></h2><p><strong>¡Renueva tus pisos!</strong><br>Contáctanos para recibir<br>asesoría personalizada.</p></div>
      {% render 'spc-actions', contact_url: contact_url, catalog_url: catalog_url %}
      <p class="spc-copyright">Decokasa Perú {{ 'now' | date: '%Y' }} · Todos los derechos reservados</p>
    </footer>
  </div>
</div>
{% schema %}
{
  "name": "Landing Piso SPC", "tag": "section", "class": "spc-shopify-section",
  "settings": [
    {"type": "checkbox", "id": "show_top_announcement", "label": "Mostrar aviso superior", "default": true},
    {"type": "text", "id": "whatsapp_phone", "label": "WhatsApp (país + número)", "default": "51941599516"},
    {"type": "url", "id": "catalog_url", "label": "Enlace al catálogo", "info": "Sin enlace, los botones llevan a las muestras de colores de esta página."},
    {"type": "text", "id": "coverage_m2", "label": "m² por caja (respaldo SPC)", "default": "2.196", "info": "El metacampo decokasa.coverage_m2 de variante o producto tiene prioridad. Usa punto decimal."},
    {"type": "checkbox", "id": "show_certifications", "label": "Mostrar sellos validados", "default": false, "info": "Activa solo después de confirmar que los seis sellos del mockup corresponden a este producto."}
  ],
  "max_blocks": 2,
  "blocks": [{"type": "testimonial", "name": "Testimonio autorizado", "settings": [
    {"type": "image_picker", "id": "portrait", "label": "Retrato autorizado"},
    {"type": "text", "id": "name", "label": "Nombre del cliente"},
    {"type": "textarea", "id": "quote", "label": "Testimonio real"}
  ]}]
}
{% endschema %}
