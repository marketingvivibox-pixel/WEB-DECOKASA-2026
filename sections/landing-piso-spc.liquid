<script>
(function() {
  const pricePerBox = {{ section.settings.price_pen }};
  const coveragePerBox = 2.196;

  const areaInput = document.getElementById('spc-area-input');
  const marginBtns = document.querySelectorAll('.spc-margin-btn');
  const colorSelect = document.getElementById('spc-color-select');
  const boxesCountEl = document.getElementById('spc-boxes-count');
  const netAreaEl = document.getElementById('spc-net-area-val');
  const totalAreaEl = document.getElementById('spc-total-area-val');
  const coveredAreaEl = document.getElementById('spc-covered-area-val');
  const totalCostEl = document.getElementById('spc-total-cost-val');
  const waBtn = document.getElementById('spc-calc-whatsapp-btn');

  let currentMargin = 5;

  function recalculate() {
    if (!areaInput) return;
    const netArea = parseFloat(areaInput.value) || 0;
    const areaWithMargin = netArea * (1 + currentMargin / 100);
    const boxes = Math.ceil(areaWithMargin / coveragePerBox);
    const totalCovered = boxes * coveragePerBox;
    const totalCost = boxes * pricePerBox;
    const selectedColor = colorSelect ? colorSelect.value : 'Roble Natural';

    if (boxesCountEl) boxesCountEl.textContent = boxes;
    if (netAreaEl) netAreaEl.textContent = netArea.toFixed(2) + ' m²';
    if (totalAreaEl) totalAreaEl.textContent = areaWithMargin.toFixed(2) + ' m²';
    if (coveredAreaEl) coveredAreaEl.textContent = totalCovered.toFixed(2) + ' m²';
    if (totalCostEl) totalCostEl.textContent = 'S/ ' + totalCost.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    if (waBtn) {
      const msg = encodeURIComponent(
        `Hola Decokasa, deseo cotizar Piso SPC Premium:\n` +
        `- Área estimada: ${netArea.toFixed(2)} m² (con ${currentMargin}% recortes = ${areaWithMargin.toFixed(2)} m²)\n` +
        `- Cajas calculadas: ${boxes} cajas (${totalCovered.toFixed(2)} m²)\n` +
        `- Color elegido: ${selectedColor}\n` +
        `- Inversión estimada: S/ ${totalCost.toFixed(2)}\n` +
        `¿Tienen stock disponible y despacho a mi zona?`
      );
      waBtn.href = `https://wa.me/{{ section.settings.whatsapp_phone }}?text=${msg}`;
    }
  }

  if (areaInput) areaInput.addEventListener('input', recalculate);
  if (colorSelect) colorSelect.addEventListener('change', recalculate);

  marginBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      marginBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMargin = parseInt(btn.dataset.margin, 10);
      recalculate();
    });
  });

  // Swatch card click
  document.querySelectorAll('.spc-swatch-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.spc-swatch-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const col = card.dataset.color;
      if (colorSelect) {
        colorSelect.value = col;
        recalculate();
      }
    });
  });

  window.spcSubmitLead = function() {
    const name = document.getElementById('spc-lead-name').value;
    const phone = document.getElementById('spc-lead-phone').value;
    const city = document.getElementById('spc-lead-city').value;
    const status = document.getElementById('spc-lead-status');
    const msg = encodeURIComponent(`Hola Decokasa, he dejado mis datos en la landing de Piso SPC:\n- Nombre: ${name}\n- Teléfono: ${phone}\n- Ubicación: ${city}`);
    if (status) {
      status.style.display = 'block';
      status.textContent = '¡Redirigiendo a WhatsApp con tu asesor asignado...';
    }
    setTimeout(() => {
      window.open(`https://wa.me/{{ section.settings.whatsapp_phone }}?text=${msg}`, '_blank');
    }, 600);
  };

  recalculate();
})();
</script>

