{{ 'landing-piso-spc.css' | asset_url | stylesheet_tag }}
{{ 'landing-piso-spc-proportions.css' | asset_url | stylesheet_tag }}
{{ 'landing-piso-spc-layout.css' | asset_url | stylesheet_tag }}
<script src="{{ 'landing-piso-spc.js' | asset_url }}" defer></script>
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_name = product.title | default: 'Piso SPC'
  assign phone = section.settings.whatsapp_phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign contact_message = 'Hola, quiero asesoría sobre ' | append: product_name | append: ' de Decokasa.' | url_encode
  assign contact_url = 'https://wa.me/' | append: phone | append: '?text=' | append: contact_message
  assign colors_id = 'spc-colores-' | append: section.id
  assign catalog_url = section.settings.catalog_url
  if catalog_url == blank
    assign catalog_url = '#' | append: colors_id
  endif
  assign coverage = current_variant.metafields.decokasa.coverage_m2.value | default: product.metafields.decokasa.coverage_m2.value | default: section.settings.coverage_m2 | plus: 0
  assign illustrative_testimonials = false
  if section.blocks.size == 0
    if section.settings.show_illustrative_testimonials or section.settings.spc_design_preview
      assign illustrative_testimonials = true
    endif
  endif
%}


<div class="spc-page" data-spc-page data-phone="{{ phone | escape }}" data-product="{{ product_name | escape }}" data-sku="{{ current_variant.sku | escape }}" data-coverage="{{ coverage }}" data-catalog-url="{{ catalog_url | escape }}" data-section-id="{{ section.id }}" {% if section.settings.spc_design_preview %}data-spc-preview{% endif %}>
{% if section.settings.spc_design_preview %}<p class="spc-preview-note">Vista de diseño · Sellos y testimonios de muestra pendientes de validación.</p>{% endif %}
<div class="spc-canvas">
<header class="spc-v2-hero">
<img class="spc-v2-comedor-hero spc-v2-art" src="{{ 'spc-2026-comedor-hero.webp' | asset_url }}" width="1117" height="2033" alt="" loading="eager" fetchpriority="high">
{% if section.settings.show_top_announcement %}<a class="spc-v2-announcement" href="{{ catalog_url | escape }}">¡Nuevos colores disponibles! <strong>Mira el catálogo aquí →</strong></a>{% endif %}
<img class="spc-v2-simbolo-marca spc-v2-art" src="{{ 'spc-2026-simbolo-marca.webp' | asset_url }}" width="118" height="116" alt="Decokasa" loading="eager" fetchpriority="high">
<h1 class="spc-v2-title">Pisos <em>SPC</em></h1>
<p class="spc-v2-tagline">Lo nuevo en revestimientos</p>
<div class="spc-v2-intro-panel spc-v2-white"></div>
<img class="spc-v2-caja-tablones-hero spc-v2-art" src="{{ 'spc-2026-caja-tablones-hero.webp' | asset_url }}" width="580" height="785" alt="Piso SPC Decokasa en acabados madera clara, gris y caoba" loading="eager" fetchpriority="high">
<p class="spc-v2-intro-copy">✨ <strong>¡Los Pisos del Futuro ya están aquí!</strong> ✨<br>Con sistema click, espuma incorporada y de instalación rápida son la mejor opción para tu hogar <strong>¡sin gastar de más!</strong> 💸🤩</p>
</header>
<section class="spc-v2-composition" aria-label="Composición del piso SPC">
<img class="spc-v2-sala-composicion spc-v2-art" src="{{ 'spc-2026-sala-composicion.webp' | asset_url }}" width="1958" height="1585" alt="" loading="lazy">
<span class="spc-v2-composition-rule spc-v2-rule"></span>
<p class="spc-v2-spc-word">SPC</p>
<img class="spc-v2-ninos-mascota spc-v2-art" src="{{ 'spc-2026-ninos-mascota.webp' | asset_url }}" width="767" height="482" alt="Niños jugando con su mascota sobre un piso con acabado de madera" loading="lazy">
<h2 class="spc-v2-composition-heading">¿Qué es el piso SPC?</h2>
        <p class="spc-v2-composition-copy">El Piso SPC (Stone Plastic Composite), es un tipo de <strong>revestimiento vinílico de alta gama para el suelo</strong>, con núcleo rígido, hecho de polvo de piedra y PVC.</p>
<div class="spc-v2-composition-rim" aria-hidden="true"></div>
</section>
<section class="spc-v2-colors-specs spc-v2-white">
<div class="spc-v2-colors-heading spc-v2-heading"><h2>Variedad para elegir</h2><p>Colores disponibles</p></div>
<div id="{{ colors_id }}" class="spc-v2-samples spc-colors" aria-label="Colores de referencia">
<div class="spc-v2-sample"><button type="button" class="spc-v2-swatch" data-color="Madera natural" aria-pressed="true"><img src="{{ 'spc-2026-muestra-calida.webp' | asset_url }}" width="266" height="266" alt="Madera natural" loading="lazy"><span>Tonos <strong>cálidos</strong></span></button><a class="spc-v2-gold-link" href="{{ contact_url | escape }}" target="_blank" rel="noopener" aria-label="Consultar tonos cálidos">Ver más</a></div>
<div class="spc-v2-sample"><button type="button" class="spc-v2-swatch" data-color="Caoba" aria-pressed="false"><img src="{{ 'spc-2026-muestra-oscura.webp' | asset_url }}" width="263" height="263" alt="Caoba" loading="lazy"><span>Tonos <strong>oscuros</strong></span></button><a class="spc-v2-gold-link" href="{{ contact_url | escape }}" target="_blank" rel="noopener" aria-label="Consultar tonos oscuros">Ver más</a></div>
<div class="spc-v2-sample"><button type="button" class="spc-v2-swatch" data-color="Gris claro" aria-pressed="false"><img src="{{ 'spc-2026-muestra-neutra.webp' | asset_url }}" width="261" height="261" alt="Gris claro" loading="lazy"><span>Tonos <strong>neutros</strong></span></button><a class="spc-v2-gold-link" href="{{ contact_url | escape }}" target="_blank" rel="noopener" aria-label="Consultar tonos neutros">Ver más</a></div>
<p data-color-status class="spc-visually-hidden" aria-live="polite">Madera natural · Color de referencia</p></div>
<p class="spc-v2-colors-copy">Los pisos están disponibles en una amplia gama de <strong>colores, texturas y diseños</strong>, ¡Elige tu favorito!</p>
<span class="spc-v2-spec-rule spc-v2-rule"></span>
<div class="spc-v2-spec-heading spc-v2-heading"><h2>Calidad inigualable</h2><p>Ficha técnica</p></div>
<dl class="spc-v2-spec-data"><div><dt>Medidas:</dt><dd>18,4 × 122 cm</dd></div><div><dt>1 caja:</dt><dd>10 planchas</dd></div><div><dt>Rendimiento:</dt><dd>{{ coverage }} m² / caja</dd></div><div><dt>Espesor:</dt><dd>4 mm</dd></div><div><dt>Desgaste:</dt><dd>0,3 mm</dd></div><div><dt>Espuma:</dt><dd>1,5 mm</dd></div></dl>
<img class="spc-v2-tablones-ficha spc-v2-art" src="{{ 'spc-2026-tablones-ficha.webp' | asset_url }}" width="815" height="670" alt="Tres tablones SPC con acabados de madera" loading="lazy">
</section>
{% if section.settings.show_certifications or section.settings.spc_design_preview %}<section class="spc-v2-certifications" aria-label="Sellos de calidad">
<img class="spc-v2-hojas-fondo spc-v2-art" src="{{ 'spc-2026-hojas-fondo.webp' | asset_url }}" width="1254" height="836" alt="" loading="lazy">
<div class="spc-v2-cert-panel spc-v2-white"></div>
<div class="spc-v2-cert-heading spc-v2-heading"><h2>Bienestar Garantizado</h2><p>Sellos de calidad</p></div>
<div class="spc-seals" aria-label="{% if section.settings.spc_design_preview %}Sellos del mockup pendientes de validar{% else %}Certificaciones del producto{% endif %}">
<img class="spc-v2-sello-floorscore-color spc-v2-art" src="{{ 'spc-2026-sello-floorscore-color.webp' | asset_url }}" width="135" height="107" alt="FLOORSCORE" loading="lazy">
<img class="spc-v2-sello-anab-color spc-v2-art" src="{{ 'spc-2026-sello-anab-color.webp' | asset_url }}" width="135" height="123" alt="ANAB" loading="lazy">
<img class="spc-v2-sello-ilac-color spc-v2-art" src="{{ 'spc-2026-sello-ilac-color.webp' | asset_url }}" width="112" height="113" alt="ILAC" loading="lazy">
<img class="spc-v2-sello-dakks-color spc-v2-art" src="{{ 'spc-2026-sello-dakks-color.webp' | asset_url }}" width="223" height="93" alt="DAKKS" loading="lazy">
<img class="spc-v2-sello-cnas-color spc-v2-art" src="{{ 'spc-2026-sello-cnas-color.webp' | asset_url }}" width="123" height="93" alt="CNAS" loading="lazy">
<img class="spc-v2-sello-eph-color spc-v2-art" src="{{ 'spc-2026-sello-eph-color.webp' | asset_url }}" width="185" height="99" alt="EPH" loading="lazy">
</div>
<img class="spc-v2-hojas-izquierda spc-v2-art" src="{{ 'spc-2026-hojas-izquierda.webp' | asset_url }}" width="481" height="313" alt="" loading="lazy">
<img class="spc-v2-hojas-derecha spc-v2-art" src="{{ 'spc-2026-hojas-derecha.webp' | asset_url }}" width="480" height="313" alt="" loading="lazy">
<p class="spc-v2-cert-note">Con <strong>certificaciones internacionales</strong> que avalan su salubridad, desempeño y calidad. 🥇</p>
</section>{% endif %}
<section class="spc-v2-click">
<img class="spc-v2-click-fondo spc-v2-art" src="{{ 'spc-2026-click-fondo.webp' | asset_url }}" width="1080" height="889" alt="" loading="lazy">
<h2 class="spc-v2-click-word">Click!</h2>
<img class="spc-v2-instalador-click spc-v2-art" src="{{ 'spc-2026-instalador-click.webp' | asset_url }}" width="870" height="600" alt="Instalador encajando un tablón mediante el sistema Click" loading="lazy">
<img class="spc-v2-click-plank-glow spc-v2-art" src="{{ 'spc-click-borde-tablon.svg' | asset_url }}" width="828" height="300" alt="" loading="lazy">
<p class="spc-v2-click-copy">¡Colócalos y retíralos <strong>cuando quieras</strong> gracias al<br>Sistema Click! <b>¡Instala sin pegamentos ni clavos!</b></p>
<ul class="spc-v2-benefits">
<li><img src="{{ 'spc-icono-resistencia-agua.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"><span>Resistentes<br><strong>al agua</strong></span></li>
<li><img src="{{ 'spc-icono-espuma-integrada.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"><span>Incluyen<br><strong>espuma</strong></span></li>
<li><img src="{{ 'spc-icono-transito-residencial.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"><span>Tránsito<br><strong>residencial</strong></span></li>
<li><img src="{{ 'spc-icono-pet-friendly.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"><span>Pet<br><strong>friendly</strong></span></li>
<li><img src="{{ 'spc-icono-sistema-click.svg' | asset_url }}" width="120" height="130" alt="" loading="lazy"><span>Textura<br><strong>realista</strong></span></li>
</ul></section>
<section class="spc-v2-layers spc-v2-white">
<div class="spc-v2-layers-heading spc-v2-heading"><h2>Ultra resistentes</h2><p>Con 5 capas de SPC</p></div>
<ol class="spc-v2-layer-list"><li>Protección UV</li><li>Capa de resistencia</li><li>Diseño decorativo</li><li>Tablero SPC</li><li>Espuma*</li></ol>
<p class="spc-v2-layer-note">*No necesita que se coloque espuma extra en la superficie a colocar el piso.</p>
<img class="spc-v2-despiece-cinco-capas spc-v2-art" src="{{ 'spc-2026-despiece-cinco-capas.webp' | asset_url }}" width="569" height="602" alt="Cinco capas del piso SPC: protección UV, resistencia, diseño, tablero rígido y espuma" loading="lazy">
<svg class="spc-v2-layer-leaders" viewBox="0 0 190 295" fill="none" stroke="#b79c24" stroke-width="1.3" aria-hidden="true"><path d="M0 0H160 M0 40H160 M0 80H160 M0 120H160 M0 160H100L160 275"/><g fill="none"><circle cx="160" cy="0" r="5"/><circle cx="160" cy="40" r="5"/><circle cx="160" cy="80" r="5"/><circle cx="160" cy="120" r="5"/><circle cx="160" cy="275" r="5"/></g></svg>
</section>
<section class="spc-v2-calculator" id="calculadora-{{ section.id }}" tabindex="-1" aria-label="Calculadora de cajas SPC">
  <img class="spc-v2-instalacion-fondo spc-v2-art" src="{{ 'spc-2026-instalacion-fondo.webp' | asset_url }}" width="1080" height="1040" alt="" loading="lazy">
  <div class="spc-calc-title-group">
    <h2>{{ 'spc.calculator.title' | t }}</h2>
    <p class="spc-calc-subtitle">{{ 'spc.calculator.subtitle' | t }}</p>
  </div>
  <form class="spc-calculator" data-spc-calculator novalidate>
    <div class="spc-calc-grid">
      <div class="spc-calc-col-inputs">
        <div class="spc-calc-tabs" role="tablist" aria-label="Modo de cálculo">
          <button type="button" class="spc-calc-tab is-active" data-calc-mode="dimensions" role="tab" aria-selected="true" id="tab-dim-{{ section.id }}" aria-controls="panel-dim-{{ section.id }}">{{ 'spc.calculator.dimensions' | t }}</button>
          <button type="button" class="spc-calc-tab" data-calc-mode="direct" role="tab" aria-selected="false" tabindex="-1" id="tab-dir-{{ section.id }}" aria-controls="panel-dir-{{ section.id }}">{{ 'spc.calculator.direct' | t }}</button>
        </div>
        <div class="spc-calc-panel" id="panel-dim-{{ section.id }}" role="tabpanel" aria-labelledby="tab-dim-{{ section.id }}" data-panel="dimensions">
          <div class="spc-rooms-container" data-rooms-container>
            <div class="spc-room-card" data-room-item="0">
              <div class="spc-room-header">
                <input type="text" class="spc-room-name-input" value="Ambiente 1" aria-label="Nombre del ambiente" placeholder="Nombre (ej. Sala)" data-room-name>
                <span class="spc-room-subtotal" data-room-subtotal>0.00 m²</span>
                <button type="button" class="spc-room-remove" data-room-remove aria-label="Eliminar este ambiente" hidden title="Eliminar ambiente"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
              </div>
              <div class="spc-room-fields">
                <div class="spc-dim-field">
                  <label for="room-0-len-{{ section.id }}">Largo</label>
                  <div class="spc-dim-box"><input id="room-0-len-{{ section.id }}" type="number" step="0.01" min="0.1" max="100" inputmode="decimal" placeholder="4.50" data-dim="length"><span class="spc-unit">m</span></div>
                </div>
                <span class="spc-dim-mult" aria-hidden="true">×</span>
                <div class="spc-dim-field">
                  <label for="room-0-wid-{{ section.id }}">Ancho</label>
                  <div class="spc-dim-box"><input id="room-0-wid-{{ section.id }}" type="number" step="0.01" min="0.1" max="100" inputmode="decimal" placeholder="3.20" data-dim="width"><span class="spc-unit">m</span></div>
                </div>
              </div>
            </div>
          </div>
          <button type="button" class="spc-add-room-btn" data-add-room><span class="spc-add-icon-badge" aria-hidden="true">+</span><span>{{ 'spc.calculator.add_room' | t }}</span></button>
        </div>
        <div class="spc-calc-panel" id="panel-dir-{{ section.id }}" role="tabpanel" aria-labelledby="tab-dir-{{ section.id }}" data-panel="direct" hidden>
          <div class="spc-direct-group">
            <label for="spc-area-{{ section.id }}">{{ 'spc.calculator.area' | t }}</label>
            <div class="spc-direct-input-box"><input id="spc-area-{{ section.id }}" name="area" type="number" min="0.01" max="100000" step="any" inputmode="decimal" placeholder="Ej. 25" aria-describedby="spc-calc-error-{{ section.id }}"><span class="spc-direct-unit">m²</span></div>
            <div class="spc-chips-list" aria-label="Áreas frecuentes">
              <button type="button" class="spc-quick-chip" data-quick-area="15">15 m²</button>
              <button type="button" class="spc-quick-chip" data-quick-area="20">20 m²</button>
              <button type="button" class="spc-quick-chip" data-quick-area="35">35 m²</button>
              <button type="button" class="spc-quick-chip" data-quick-area="50">50 m²</button>
            </div>
          </div>
        </div>
        <div class="spc-waste-box">
          <label class="spc-waste-toggle">
            <input type="checkbox" name="waste" checked>
            <span class="spc-switch-track" aria-hidden="true"><span class="spc-switch-thumb"></span></span>
            <span class="spc-switch-text"><strong>{{ 'spc.calculator.waste' | t }}</strong><small>{{ 'spc.calculator.recommended' | t }}</small></span>
          </label>
        </div>
        <p class="spc-calc-error" id="spc-calc-error-{{ section.id }}" data-calc-error role="alert" hidden></p>
      </div>
      <div class="spc-calc-col-result">
        <div class="spc-result-card" data-calc-result>
          <div class="spc-result-summary" role="status" aria-live="polite" aria-atomic="true">
            <div class="spc-result-metrics">
              <div><span class="spc-metric-label">{{ 'spc.calculator.you_need' | t }}</span><strong class="spc-boxes-val" data-boxes>— cajas</strong></div>
              <div><span class="spc-metric-label">{{ 'spc.calculator.estimate' | t }}</span><strong class="spc-estimate-val" data-calc-estimate data-unconfirmed="{{ 'spc.calculator.unconfirmed' | t | escape }}">—</strong></div>
            </div>
            <span class="spc-boxes-caption" data-boxes-status>Ingresa medidas para calcular</span>
          </div>
          <div class="spc-mini-space is-empty" data-mini-space>
            <div class="spc-mini-space-copy"><span>{{ 'spc.calculator.your_space' | t }}</span><strong data-mini-area>— m²</strong></div>
            <div class="spc-mini-space-stage" data-mini-stage aria-hidden="true"></div>
          </div>
          <a class="spc-button spc-button--order spc-calc-order" data-open-request href="#solicitud">{{ 'spc.calculator.request' | t }} <span aria-hidden="true">→</span></a>
          <p class="spc-estimate-note">{{ 'spc.calculator.estimate_note' | t }}</p>
          <details class="spc-calc-details">
            <summary>{{ 'spc.calculator.details' | t }}<span aria-hidden="true">+</span></summary>
            <div class="spc-breakdown-details">
              <div class="spc-detail-item"><span class="spc-detail-name">Área neta</span><strong class="spc-detail-num" data-net-area>0.00 m²</strong></div>
              <div class="spc-detail-item"><span class="spc-detail-name" data-target-label>Con cortes (+10%)</span><strong class="spc-detail-num spc-gold" data-target-area>0.00 m²</strong></div>
              <div class="spc-detail-item"><span class="spc-detail-name">Cobertura total</span><strong class="spc-detail-num" data-covered>0.00 m²</strong></div>
              <div class="spc-detail-item"><span class="spc-detail-name">Sobrante estimado</span><strong class="spc-detail-num" data-leftover>0.00 m²</strong></div>
            </div>
            <p class="spc-calc-help">{{ coverage }} m² por caja · 10 planchas por caja</p>
            <p class="spc-planks-info" data-planks-wrap><span data-planks-text>Equivale a — planchas</span></p>
            <div class="spc-schematic-wrap" data-schematic-wrap>
              <div class="spc-schematic-topbar"><span class="spc-schematic-label">Croquis de tu espacio</span><span class="spc-schematic-legend" data-schematic-legend>Vista proporcional</span></div>
              <div class="spc-schematic-stage" data-schematic-stage></div>
            </div>
          </details>
        </div>
        <a class="spc-calc-catalog" data-calc-contact href="{{ catalog_url | escape }}">{{ 'spc.calculator.colors' | t }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <noscript><p class="spc-noscript-warn">Activa JavaScript para calcular las cajas o consulta directamente con un asesor.</p></noscript>
  </form>
</section>
<section class="spc-v2-testimonials spc-testimonials{% if illustrative_testimonials %} spc-testimonials--illustrative{% elsif section.blocks.size == 0 %} spc-testimonials--pending{% endif %}" aria-label="Testimonios{% if illustrative_testimonials %} ilustrativos{% else %} de clientes{% endif %}" data-spc-testimonials>
    <img class="spc-v2-testimonials-fondo" src="{{ 'spc-2026-testimonios-fondo.webp' | asset_url }}" width="1080" height="1018" loading="lazy" alt="">
<div class="spc-v2-testimonial-panel spc-v2-white"></div>
<div class="spc-v2-socials" aria-hidden="true">
<svg viewBox="0 0 35 35"><circle cx="17.5" cy="17.5" r="17"/><path d="M19 8v14a4 4 0 1 1-4-4v3a1.5 1.5 0 1 0 1.5 1.5V8h3c0 4 2 6 5 6v3c-2 0-4-1-5-2"/></svg>
<svg viewBox="0 0 35 35"><circle cx="17.5" cy="17.5" r="17"/><rect x="9" y="9" width="17" height="17" rx="5"/><circle class="spc-social-line" cx="17.5" cy="17.5" r="4"/><path d="M23 12h.1"/></svg>
<svg viewBox="0 0 35 35"><circle cx="17.5" cy="17.5" r="17"/><path d="M20 29V19h4l1-4h-5v-3c0-2 1-2 4-2V6h-4c-4 0-5 2-5 6v3h-3v4h3v10"/></svg>
</div>
<div class="spc-v2-testimonials-heading spc-v2-heading"><h2>Testimonios</h2><p>{% if illustrative_testimonials %}Ejemplos ilustrativos{% else %}De nuestros clientes{% endif %}</p></div>
{% if illustrative_testimonials %}<p class="spc-testimonial-sample-note">Imágenes de IA · Textos de muestra.<br>No son reseñas de clientes reales.</p>{% endif %}
{% if section.blocks.size > 0 or illustrative_testimonials %}
<button class="spc-testimonial-pause" type="button" data-testimonial-pause aria-label="Pausar testimonios" aria-pressed="false" hidden><span aria-hidden="true">Ⅱ</span></button>
<div class="spc-v2-quotes" tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Testimonios. Desliza o usa las flechas para ver más" data-testimonial-viewport>
<div class="spc-testimonial-track"><div class="spc-testimonial-group" data-testimonial-original>
{% for block in section.blocks %}
<figure class="spc-quote" {{ block.shopify_attributes }}>
<p class="spc-v2-city"><span aria-hidden="true">⌖</span> {{ block.settings.city | escape }}</p>
{% if block.settings.portrait != blank %}{{ block.settings.portrait | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name }}{% endif %}
<figcaption>{{ block.settings.name | escape }}</figcaption><span class="spc-stars" aria-label="5 de 5 estrellas">★★★★★</span>
<blockquote>{% if block.settings.headline != blank %}<strong>{{ block.settings.headline | escape }}</strong>{% endif %}<p>{{ block.settings.quote | escape }}</p></blockquote>
</figure>{% endfor %}
{% if illustrative_testimonials %}
<figure class="spc-quote spc-quote--sample"><p class="spc-v2-city"><span aria-hidden="true">⌖</span> Lima</p><img src="{{ 'spc-2026-retrato-muestra-lima.webp' | asset_url }}" width="161" height="161" loading="lazy" alt="Retrato ilustrativo generado con IA"><figcaption>Carlos M.</figcaption><span class="spc-illustrative-label">Ejemplo ilustrativo</span><blockquote><strong>“Excelente acabado y fácil de limpiar”</strong><p>Tiene una apariencia muy similar a la madera y limpiarlo es bastante sencillo.</p></blockquote></figure>
<figure class="spc-quote spc-quote--sample"><p class="spc-v2-city"><span aria-hidden="true">⌖</span> Arequipa</p><img src="{{ 'spc-2026-retrato-muestra-arequipa.webp' | asset_url }}" width="161" height="161" loading="lazy" alt="Retrato ilustrativo generado con IA"><figcaption>María R.</figcaption><span class="spc-illustrative-label">Ejemplo ilustrativo</span><blockquote><strong>“Mi sala luce completamente diferente”</strong><p>El piso SPC le dio un acabado super elegante, ¡me encantó!</p></blockquote></figure>
<figure class="spc-quote spc-quote--sample"><p class="spc-v2-city"><span aria-hidden="true">⌖</span> Cañete</p><img src="{{ 'spc-2026-retrato-muestra-canete.webp' | asset_url }}" width="161" height="161" loading="lazy" alt="Retrato ilustrativo generado con IA"><figcaption>Adela J.</figcaption><span class="spc-illustrative-label">Ejemplo ilustrativo</span><blockquote><strong>“Renové mi departamento gastando poco”</strong><p>No quería gastar en una remodelación completa, así que busqué el piso SPC. Recomendado.</p></blockquote></figure>
<figure class="spc-quote spc-quote--sample"><p class="spc-v2-city"><span aria-hidden="true">⌖</span> Huánuco</p><img src="{{ 'spc-2026-retrato-muestra-huanuco.webp' | asset_url }}" width="161" height="161" loading="lazy" alt="Retrato ilustrativo generado con IA"><figcaption>Jhon M.</figcaption><span class="spc-illustrative-label">Ejemplo ilustrativo</span><blockquote><strong>“El dormitorio se siente más cálido”</strong><p>Elegí un tono madera para mi dormitorio y me encantó el resultado. Combina muy bien.</p></blockquote></figure>
<figure class="spc-quote spc-quote--sample"><p class="spc-v2-city"><span aria-hidden="true">⌖</span> Trujillo</p><img src="{{ 'spc-2026-retrato-muestra-trujillo.webp' | asset_url }}" width="161" height="161" loading="lazy" alt="Retrato ilustrativo generado con IA"><figcaption>Lucía Z.</figcaption><span class="spc-illustrative-label">Ejemplo ilustrativo</span><blockquote><strong>“La instalación fue más sencilla de lo que pensé”</strong><p>Tenía dudas sobre cómo quedaría la instalación, pero el sistema click facilitó bastante el trabajo.</p></blockquote></figure>
{% endif %}
</div></div></div>
{% else %}<div class="spc-testimonial-pending"><p>Pronto compartiremos aquí las experiencias de nuestros clientes.</p><a href="{{ contact_url | escape }}" target="_blank" rel="noopener">Conversa con un asesor sobre tu proyecto</a></div>{% endif %}
</section>
<section class="spc-v2-results">
<img class="spc-v2-sala-resultados spc-v2-art" src="{{ 'spc-2026-sala-resultados.webp' | asset_url }}" width="1205" height="950" alt="Sala con piso SPC y acabados de madera" loading="lazy">
<p class="spc-v2-results-note">*Algunos colores y texturas pueden variar. <a href="{{ contact_url | escape }}" target="_blank" rel="noopener">Consultar con un asesor aquí.</a></p>
<div class="spc-v2-results-heading spc-v2-heading"><h2>Resultados &amp; Acabados</h2><p>Muestras reales</p></div>
</section>
<section class="spc-v2-shipping">
<img class="spc-v2-almacen-envios spc-v2-art" src="{{ 'spc-2026-almacen-envios.webp' | asset_url }}" width="1080" height="1026" alt="" loading="lazy">
<div class="spc-v2-shipping-stripe" aria-hidden="true"></div>
<div class="spc-v2-shipping-frame" aria-hidden="true"></div>
<div class="spc-v2-shipping-social-header" aria-hidden="true">
  <span class="spc-v2-shipping-avatar"><img src="{{ 'decokasa-logo.webp' | asset_url }}" width="32" height="32" alt="" loading="lazy"></span>
  <span class="spc-v2-shipping-account"><span><b>decokasa.pe</b><span class="spc-v2-shipping-follow"> · Seguir</span></span><span>Audio original</span></span>
  <span class="spc-v2-shipping-options">•••</span>
</div>
<img class="spc-v2-shipping-person spc-v2-art" src="{{ 'spc-2026-asesoria-envios.webp' | asset_url }}" width="398" height="451" alt="Asesoría para elegir y coordinar el envío de tu piso SPC" loading="lazy">
<div class="spc-v2-shipping-social-actions" aria-hidden="true">
  <svg class="spc-v2-shipping-heart" viewBox="0 0 36 36"><path d="M18 31 4 18C-7 6 9-3 18 8 27-3 43 6 32 18Z"/></svg>
  <svg viewBox="0 0 36 36"><path d="M30 26 32 33 24 30A15 15 0 1 1 30 26Z"/></svg>
  <svg viewBox="0 0 38 36"><path d="m2 3 34-1-15 31-5-18L2 3Zm14 12L36 2"/></svg>
  <svg class="spc-v2-shipping-bookmark" viewBox="0 0 34 38"><path d="M4 3h26v32L17 25 4 35Z"/></svg>
</div>
<p class="spc-v2-shipping-social-views">{% if section.settings.spc_design_preview %}15.328 views{% else %}Asesoría y envíos · Decokasa{% endif %}</p>
<div class="spc-v2-shipping-heading spc-v2-heading"><h2><span class="spc-v2-peru-flag" aria-hidden="true"></span><span>¡Nuestros pisos llegan a todo Perú!</span><span class="spc-v2-peru-flag" aria-hidden="true"></span></h2></div>
<p class="spc-v2-shipping-copy">Realiza tu pedido. elige tu agencia o delivery de<br>preferencia, <strong>¡Y listo!</strong></p>
<p class="spc-v2-shipping-note">*¡Cotiza tus envíos con los asesores de venta Decokasa!</p>
</section>
<footer class="spc-v2-footer spc-v2-white">
<img class="spc-v2-caja-tablones-footer spc-v2-art" src="{{ 'spc-2026-caja-tablones-footer.webp' | asset_url }}" width="832" height="899" alt="Caja y tablones de piso SPC Decokasa" loading="lazy">
<div class="spc-v2-footer-heading spc-v2-heading"><h2>Cotiza tus pisos hoy</h2><p>¡Gratis y sin compromiso!</p></div>
<div class="spc-v2-footer-actions">{% render 'spc-actions', contact_url: contact_url, catalog_url: catalog_url %}</div>
<p class="spc-v2-copyright">Decokasa Perú {{ 'now' | date: '%Y' }}<br>Todos los derechos reservados</p>
</footer></div>

<dialog class="spc-v2-dialog spc-v2-request-dialog" data-spc-modal aria-label="Solicitud de piso SPC"><button class="spc-v2-dialog-close" type="button" data-modal-close aria-label="Cerrar solicitud">×</button>{% render 'request-form', product: product %}</dialog>
<a class="spc-mobile-sticky-cta" data-spc-sticky-cta href="#calculadora-{{ section.id }}" inert><strong>Realizar pedido</strong><span>Calcula tus cajas de piso SPC →</span></a>
</div>
{% schema %}
{
  "name": "Landing Piso SPC",
  "tag": "section",
  "class": "spc-shopify-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_announcement",
      "label": "Mostrar aviso superior",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "WhatsApp (país + número)",
      "default": "51941599516"
    },
    {
      "type": "url",
      "id": "catalog_url",
      "label": "Enlace al catálogo",
      "info": "Sin enlace, los botones llevan a las muestras de colores de esta página."
    },
    {
      "type": "text",
      "id": "coverage_m2",
      "label": "m² por caja (respaldo SPC)",
      "default": "2.196",
      "info": "El metacampo decokasa.coverage_m2 de variante o producto tiene prioridad. Usa punto decimal."
    },
    {
      "type": "checkbox",
      "id": "show_illustrative_testimonials",
      "label": "Mostrar ejemplos ilustrativos",
      "default": false,
      "info": "Sin testimonios configurados, muestra las cinco tarjetas del mockup identificadas como imágenes de IA y textos de muestra. Los bloques reales tienen prioridad."
    },
    {
      "type": "checkbox",
      "id": "show_certifications",
      "label": "Mostrar sellos validados",
      "default": false,
      "info": "Activa solo después de confirmar que los seis sellos del mockup corresponden a este producto."
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio autorizado",
      "settings": [
        {
          "type": "image_picker",
          "id": "portrait",
          "label": "Retrato autorizado"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre del cliente"
        },
        {
          "type": "text",
          "id": "city",
          "label": "Ciudad del cliente"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Frase destacada del testimonio"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonio real"
        }
      ]
    }
  ]
}
{% endschema %}
