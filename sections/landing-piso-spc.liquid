<!-- Interactive Logic for Calculator and Swatches -->
<script>
  (function() {
    var BOX_COVERAGE = 2.196;
    var PRICE_PER_BOX = {{ section.settings.price_pen }};
    var WHATSAPP_PHONE = "{{ section.settings.whatsapp_phone }}";
    var currentMargin = 5;

    var areaInput = document.getElementById('spc-calc-area');
    var colorSelect = document.getElementById('spc-calc-color');
    var marginPills = document.querySelectorAll('.spc-margin-pill');
    var netAreaEl = document.getElementById('spc-result-net-area');
    var totalAreaEl = document.getElementById('spc-result-total-area');
    var coveredEl = document.getElementById('spc-result-covered');
    var boxesEl = document.getElementById('spc-result-boxes');
    var totalPriceEl = document.getElementById('spc-result-total-price');
    var quoteBtn = document.getElementById('spc-whatsapp-quote-btn');

    function updateCalculations() {
      var netArea = parseFloat(areaInput.value) || 0;
      if (netArea < 0) netArea = 0;

      var totalWithMargin = netArea * (1 + (currentMargin / 100));
      var boxesNeeded = Math.ceil(totalWithMargin / BOX_COVERAGE);
      if (boxesNeeded < 1 && netArea > 0) boxesNeeded = 1;

      var actualCovered = boxesNeeded * BOX_COVERAGE;
      var totalCost = boxesNeeded * PRICE_PER_BOX;
      var selectedColor = colorSelect ? colorSelect.value : 'Roble Natural';

      if (netAreaEl) netAreaEl.textContent = netArea.toFixed(2) + ' m²';
      if (totalAreaEl) totalAreaEl.textContent = totalWithMargin.toFixed(2) + ' m²';
      if (coveredEl) coveredEl.textContent = actualCovered.toFixed(2) + ' m²';
      if (boxesEl) boxesEl.textContent = boxesNeeded;
      if (totalPriceEl) totalPriceEl.textContent = 'S/ ' + totalCost.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      // Update WhatsApp link with prefilled quotation message
      if (quoteBtn) {
        var msg = 'Hola Decokasa, calculé ' + netArea.toFixed(1) + ' m² para mi proyecto de Piso SPC (Tono: ' + selectedColor + '). Requiero ' + boxesNeeded + ' cajas (~' + actualCovered.toFixed(2) + ' m²) con un presupuesto estimado de S/ ' + totalCost.toFixed(2) + '. Deseo coordinar compra y despacho.';
        quoteBtn.href = 'https://wa.me/' + WHATSAPP_PHONE + '?text=' + encodeURIComponent(msg);
      }
    }

    if (areaInput) {
      areaInput.addEventListener('input', updateCalculations);
    }
    if (colorSelect) {
      colorSelect.addEventListener('change', updateCalculations);
    }

    marginPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        marginPills.forEach(function(p) { p.classList.remove('active'); });
        pill.classList.add('active');
        currentMargin = parseFloat(pill.getAttribute('data-margin')) || 0;
        updateCalculations();
      });
    });

    // Swatches selection
    var colorCards = document.querySelectorAll('.spc-color-card');
    colorCards.forEach(function(card) {
      card.addEventListener('click', function() {
        colorCards.forEach(function(c) { c.classList.remove('active'); });
        card.classList.add('active');
        var color = card.getAttribute('data-color');
        if (colorSelect) {
          colorSelect.value = color;
          updateCalculations();
        }
      });
    });

    // Form Submission
    window.spcSubmitAdvisorForm = function() {
      var name = document.getElementById('spc-name').value.trim();
      var phone = document.getElementById('spc-phone').value.trim();
      var city = document.getElementById('spc-city').value.trim();
      var notes = document.getElementById('spc-notes').value.trim();
      var statusEl = document.getElementById('spc-form-status');

      if (!name || !phone) {
        if (statusEl) {
          statusEl.style.display = 'block';
          statusEl.style.color = '#ef4444';
          statusEl.textContent = 'Por favor completa tu nombre y WhatsApp.';
        }
        return;
      }

      var msg = 'Hola Decokasa, mi nombre es ' + name + ' (Telf: ' + phone + '). ' +
                (city ? 'Estoy en: ' + city + '. ' : '') +
                (notes ? 'Detalle de mi proyecto: ' + notes + '. ' : 'Deseo cotizar Piso SPC.');

      if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.style.color = '#10b981';
        statusEl.textContent = 'Redirigiendo a WhatsApp con tu asesor técnico...';
      }

      window.open('https://wa.me/' + WHATSAPP_PHONE + '?text=' + encodeURIComponent(msg), '_blank');
    };

    // Initialize
    updateCalculations();
  })();
</script>

