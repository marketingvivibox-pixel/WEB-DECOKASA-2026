{% assign default_categories = 'sillas-gerenciales|hogar-y-acabados|sillas-gamers|tecnologia|fitness|bebes' | split: '|' %}
{% assign catalog_types = settings.catalog_categories | default: default_categories %}
<a class="skip" href="#main">Ir al contenido</a>
<div class="service-bar interface-promo" data-motion="settle">
  <a class="interface-promo-track" href="{{ routes.root_url }}#como-comprar">
    {% for i in (1..10) %}
      <span{% unless forloop.first %} aria-hidden="true"{% endunless %}>{{ section.settings.announcement | escape }}</span>
    {% endfor %}
  </a>
  <button class="interface-promo-toggle" type="button" data-promo-toggle aria-label="Pausar texto en movimiento">❚❚</button>
</div>
<header class="store-header" data-motion="settle">
  <div class="wrap store-header-row">
    <a class="store-logo" href="{{ routes.root_url }}" aria-label="DECOKASA, inicio">
      {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 480 | image_tag: widths: '160, 320, 480', sizes: '180px', loading: 'eager', alt: 'DECOKASA' }}{% else %}<img src="{{ 'decokasa-logo-2026.webp' | asset_url }}" alt="DECOKASA" width="798" height="108" loading="eager">{% endif %}
    </a>
    <form class="store-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="store-search">Buscar productos</label>
      <input id="store-search" type="search" name="q" placeholder="¿Qué estás buscando?" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Buscar">{% render 'icon', name: 'search' %}</button>
    </form>
    {% render 'customer-service', location: 'header' %}
    <button class="header-catalog" type="button" data-interface-cart aria-label="Abrir carrito" aria-haspopup="dialog" hidden>
      {% render 'icon', name: 'bag' %}<span class="interface-cart-count" data-interface-cart-count hidden></span>
    </button>
  </div>
</header>
<div class="navigation-shell" data-motion="settle">
  <button class="store-nav-arrow store-nav-arrow--prev" type="button" data-store-nav-arrow="-1" aria-label="Ver categorías anteriores">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  <nav class="wrap store-nav" aria-label="Navegación principal">
    {% for type in catalog_types %}
      {% assign category_collection = type %}
      {% if category_collection.url == blank %}{% assign category_collection = collections[type] %}{% endif %}
      {% if category_collection.url != blank %}
        {% assign category_label = category_collection.title %}
        {% assign category_thumbnail = '' %}
        {% case category_collection.handle %}
          {% when 'sillas-gerenciales' %}{% assign category_thumbnail = 'office' %}
          {% when 'hogar-y-acabados' %}{% assign category_thumbnail = 'home' %}{% assign category_label = 'Hogar y Deco' %}
          {% when 'sillas-gamers' %}{% assign category_thumbnail = 'gamer' %}
          {% when 'tecnologia' %}{% assign category_thumbnail = 'tech' %}
          {% when 'fitness' %}{% assign category_thumbnail = 'fitness' %}{% assign category_label = 'Deportes' %}
          {% when 'bebes' %}{% assign category_thumbnail = 'baby' %}{% assign category_label = 'Niños y Juguetes' %}
        {% endcase %}
        <a href="{{ category_collection.url }}" data-vt-nav="{{ forloop.index }}">{% if category_thumbnail != blank %}{% assign thumbnail_asset = 'decokasa-nav-' | append: category_thumbnail | append: '.webp' %}<img src="{{ thumbnail_asset | asset_url }}" alt="" width="40" height="40" loading="eager">{% endif %}<span>{{ category_label | escape }}</span></a>
      {% endif %}
    {% endfor %}
  </nav>
  <button class="store-nav-arrow store-nav-arrow--next" type="button" data-store-nav-arrow="1" aria-label="Ver más categorías">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
  </button>
</div>
{% render 'storefront-cart' %}
{% schema %}
{
  "name": "Cabecera",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo DECOKASA"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Texto de la franja superior",
      "default": "Compra con un asesor y coordina tu envío"
    }
  ],
  "presets": [
    {
      "name": "Cabecera"
    }
  ]
}
{% endschema %}
