{% assign default_categories = 'tecnologia|electrodomesticos|bebes|fitness|hogar-y-acabados' | split: '|' %}
{% assign catalog_types = settings.catalog_categories | default: default_categories %}
<a class="skip" href="#main">Ir al contenido</a>
<div class="service-bar interface-promo" data-motion="settle">
  <a href="{{ routes.root_url }}#como-comprar">
    {% for i in (1..9) %}
      <span{% unless forloop.first %} aria-hidden="true"{% endunless %}>{{ section.settings.announcement | escape }}</span>
    {% endfor %}
  </a>
</div>
<header class="store-header" data-motion="settle">
  <div class="wrap store-header-row">
    <a class="store-logo" href="{{ routes.root_url }}" aria-label="DECOKASA, inicio">
      {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 480 | image_tag: widths: '160, 320, 480', sizes: '180px', loading: 'eager', alt: 'DECOKASA' }}{% else %}{% render 'reference-image', crop: 'logo', loading: 'eager' %}{% endif %}
    </a>
    <form class="store-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="sr-only" for="store-search">Buscar productos</label>
      <input id="store-search" type="search" name="q" placeholder="¿Qué estás buscando?" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Buscar">{% render 'icon', name: 'search' %}</button>
    </form>
    {% render 'customer-service', location: 'header' %}
    <button class="header-catalog" type="button" data-interface-cart aria-label="Abrir carrito" aria-haspopup="dialog" hidden>
      {% render 'icon', name: 'bag' %}<span class="interface-cart-count" data-interface-cart-count hidden></span>
    </button>
  </div>
</header>
<div class="navigation-shell" data-motion="settle">
  <nav class="wrap store-nav" aria-label="Navegación principal">
    <a href="{{ routes.all_products_collection_url }}">Ver todo</a>
    {% for type in catalog_types %}
      {% assign category_collection = type %}
      {% if category_collection.url == blank %}{% assign category_collection = collections[type] %}{% endif %}
      {% if category_collection.url != blank %}<a href="{{ category_collection.url }}">{{ category_collection.title | escape }}</a>{% endif %}
    {% endfor %}
    <a href="{{ routes.root_url }}#marcas">Nuestras marcas</a>
  </nav>
</div>
{% render 'storefront-cart' %}
{% schema %}
{
  "name": "Cabecera",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo DECOKASA"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Texto de la franja superior",
      "default": "Compra con asesor · Coordina tu envío"
    }
  ],
  "presets": [
    {
      "name": "Cabecera"
    }
  ]
}
{% endschema %}
