{% assign brand_crops = 'xion|baby|biflex|hogar' | split: '|' %}
{% assign brand_names = 'Xion|Mundo Baby|Biflex|DECOKASA' | split: '|' %}
{% assign brand_handles = 'xion|mundo-baby|biflex|decokasa' | split: '|' %}
{% assign brand_keys = 'xion|baby|biflex|decokasa' | split: '|' %}
{% assign category_keys = 'acabados|cocina|fitness|bebes' | split: '|' %}
{% assign category_titles = 'Renueva pisos y paredes|Equipa tu cocina|Entrena en casa|Cuida a tu bebé' | split: '|' %}
{% assign category_handles = 'hogar-y-acabados|electrodomesticos|fitness|bebes' | split: '|' %}
{% assign slide_titles = 'Acabados para renovar tu hogar|Encuentra ideas para cada ambiente' | split: '|' %}
{% assign slide_assets = 'spc-2026-sala-composicion.webp|pvc-ambiente-sala.webp' | split: '|' %}
{% assign is_demo = false %}
{% assign featured = section.settings.featured_collection | default: collections.all %}
{% capture hero_track %}HomeHero-{{ section.id }}{% endcapture %}
{% capture featured_track %}HomeFeatured-{{ section.id }}{% endcapture %}

<section class="interface-hero" aria-label="Destacados de DECOKASA" data-carousel data-carousel-hero>
  <div class="interface-track interface-hero-track" id="{{ hero_track }}" data-carousel-track tabindex="0" aria-label="Diapositivas destacadas">
    <div class="interface-slide interface-slide--first">
      <picture class="interface-slide-picture">
        {% if section.settings.hero_image_mobile != blank %}
          <source media="(width < 900px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 1000 }}">
        {% elsif section.settings.hero_image == blank %}
          <source media="(width < 900px)" srcset="{{ 'decokasa-inicio-portada-movil.webp' | asset_url }}">
        {% endif %}
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1920 | image_tag: widths: '640, 960, 1440, 1920', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'interface-slide-image', alt: '' }}
        {% else %}
          <img class="interface-slide-image" src="{{ 'decokasa-inicio-portada.webp' | asset_url }}" alt="" width="1920" height="803" fetchpriority="high">
        {% endif %}
      </picture>
      <div class="wrap interface-slide-content" data-motion="settle">
        <h1>{{ section.settings.heading | escape }} <span>{{ section.settings.heading_accent | escape }}</span></h1>
        <a class="button interface-button" href="{{ routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>
      </div>
    </div>
    {% for title in slide_titles %}
      {% assign slide_setting_id = 'hero_image_' | append: forloop.index0 %}
      {% assign extra_image = section.settings[slide_setting_id] %}
      <div class="interface-slide">
        {% if extra_image != blank %}
          {{ extra_image | image_url: width: 1920 | image_tag: widths: '640, 960, 1440, 1920', sizes: '100vw', loading: 'lazy', class: 'interface-slide-image', alt: '' }}
        {% else %}<img class="interface-slide-image" src="{{ slide_assets[forloop.index0] | asset_url }}" alt="" width="1440" height="810" loading="lazy">{% endif %}
        <div class="wrap interface-slide-content">
          <h2>{{ title }}</h2>
          <a class="button interface-button" href="{% render 'catalog-url', routes: routes, collections: collections, default_handle: 'hogar-y-acabados' %}">Explorar acabados</a>
        </div>
      </div>
    {% endfor %}
  </div>
  {% render 'storefront-carousel-controls', track_id: hero_track, dots: true %}
</section>

<section class="wrap interface-brands" id="marcas" aria-labelledby="InterfaceBrandsTitle">
  <h2 id="InterfaceBrandsTitle" data-motion>Nuestras marcas</h2>
  <div class="interface-brand-list" data-motion-group>
    {% for name in brand_names %}
      {% assign collection_setting = brand_keys[forloop.index0] | append: '_collection' %}
      <a class="interface-brand interface-brand--{{ brand_crops[forloop.index0] }}" data-motion href="{% render 'catalog-url', routes: routes, collections: collections, selected_collection: section.settings[collection_setting], default_handle: brand_handles[forloop.index0] %}">
        {% assign brand_logo = 'decokasa-marca-' | append: brand_keys[forloop.index0] | append: '.webp' %}
        <img class="interface-brand-logo" src="{{ brand_logo | asset_url }}" alt="" width="660" height="111" loading="lazy"><strong class="sr-only">{{ name }}</strong>
      </a>
    {% endfor %}
  </div>
</section>

<section class="interface-showcase" aria-labelledby="InterfaceShowcaseTitle">
  <div class="wrap">
    <h2 id="InterfaceShowcaseTitle" data-motion>{{ section.settings.promo_text | escape }}</h2>
    <div class="interface-mosaic" data-motion-group>
      {% for key in category_keys %}
        {% assign image_setting = 'category_image_' | append: key %}
        {% assign category_image = section.settings[image_setting] %}
        {% assign image_sizes = '(min-width: 900px) 22vw, 43vw' %}
        {% if forloop.first or forloop.last %}{% assign image_sizes = '(min-width: 900px) 22vw, 87vw' %}{% endif %}
        <a class="interface-tile interface-tile--{{ key }}" data-motion href="{% render 'catalog-url', routes: routes, collections: collections, default_handle: category_handles[forloop.index0] %}">
          {% if category_image != blank %}
            {{ category_image | image_url: width: 900 | image_tag: widths: '360, 640, 900', sizes: image_sizes, loading: 'lazy', class: 'interface-tile-image', alt: '' }}
          {% else %}
            {% assign category_photo = 'decokasa-categoria-' | append: key | append: '.webp' %}
            <img class="interface-tile-image" src="{{ category_photo | asset_url }}" alt="" width="900" height="600" loading="lazy">
          {% endif %}
          <span class="interface-tile-label">{{ category_titles[forloop.index0] }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% if featured.products.size > 0 %}
  <section class="wrap interface-featured" data-carousel aria-labelledby="InterfaceFeaturedTitle">
    <div class="interface-section-heading" data-motion><h2 id="InterfaceFeaturedTitle">Descubre todo lo mejor para tu hogar</h2><a href="{{ routes.all_products_collection_url }}">Ver catálogo {% render 'icon', name: 'arrow' %}</a></div>
    <div class="interface-track interface-product-track" id="{{ featured_track }}" data-carousel-track tabindex="0" aria-label="Productos populares">
      {% for product in featured.products limit: 10 %}{% render 'product-card', product: product, demo: is_demo %}{% endfor %}
    </div>
    {% render 'storefront-carousel-controls', track_id: featured_track %}
  </section>
{% endif %}

<section class="interface-how" id="como-comprar" aria-labelledby="InterfaceHowTitle">
  <div class="wrap">
    <h2 id="InterfaceHowTitle" data-motion>¿Cómo comprar en Decokasa?</h2>
    <ol class="interface-steps" data-motion-group>
      <li data-motion><span aria-hidden="true">1</span><div><h3>Encuentra tu producto</h3><p>Explora el catálogo por categoría y conoce cada producto.</p></div></li>
      <li data-motion><span aria-hidden="true">2</span><div><h3>Completa tu solicitud</h3><p>Indica la presentación y cantidad que necesitas en el formulario.</p></div></li>
      <li data-motion><span aria-hidden="true">3</span><div><h3>Coordina con un asesor</h3><p>Confirma disponibilidad, importe final, forma de pago y entrega.</p></div></li>
    </ol>
  </div>
</section>

<section class="wrap interface-wholesale" id="mayorista">
  <div class="interface-wholesale-banner" data-motion>
    <img class="interface-wholesale-image" src="{{ 'decokasa-mayorista-2026.webp' | asset_url }}" alt="" width="1440" height="810" loading="lazy">
    <div class="interface-wholesale-copy">
      <h2>División mayorista</h2>
      <p>Encuentra productos para tu negocio y consulta por las cantidades que necesitas.</p>
      <a class="button interface-button" href="{{ routes.all_products_collection_url }}">Explorar productos</a>
    </div>
  </div>
</section>
{% assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' | remove: '.' %}
{% assign whatsapp_href = section.settings.whatsapp_url %}
{% assign whatsapp_text = section.settings.whatsapp_message | url_encode %}
{% if whatsapp_href == blank and whatsapp_phone != blank %}{% assign whatsapp_href = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_text %}{% endif %}
{% if whatsapp_href != blank %}<a class="whatsapp-float" data-motion href="{{ whatsapp_href }}" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp: solicita ayuda o una cotización"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.02 3.2c-7.05 0-12.78 5.72-12.78 12.77 0 2.25.59 4.45 1.71 6.4L3.13 28.8l6.58-1.73a12.74 12.74 0 0 0 6.3 1.66h.01c7.04 0 12.77-5.73 12.77-12.78 0-3.41-1.33-6.62-3.74-9.03a12.69 12.69 0 0 0-9.03-3.72Zm0 23.36h-.01c-1.94 0-3.85-.52-5.51-1.51l-.4-.24-3.91 1.03 1.04-3.81-.26-.42a10.59 10.59 0 0 1-1.63-5.64c0-5.89 4.79-10.68 10.68-10.68 2.85 0 5.53 1.11 7.55 3.13a10.6 10.6 0 0 1 3.12 7.56c0 5.89-4.79 10.68-10.67 10.68Zm5.86-8c-.32-.16-1.9-.94-2.2-1.05-.3-.11-.51-.16-.72.16-.21.32-.83 1.05-1.02 1.27-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.58-1.6-.95-.85-1.59-1.9-1.78-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.1-.22.05-.4-.03-.56-.08-.16-.72-1.74-.98-2.39-.26-.63-.52-.55-.72-.56h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.08-1.11 2.64s1.14 3.06 1.3 3.27c.16.21 2.24 3.42 5.42 4.8.76.33 1.35.53 1.81.68.76.24 1.45.21 2 .13.61-.09 1.9-.77 2.17-1.51.27-.75.27-1.38.19-1.51-.08-.14-.29-.22-.61-.38Z"/></svg><span>WhatsApp</span></a>{% endif %}
{% schema %}
{
  "name": "Inicio multimarcas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Todo lo que necesitas,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Título en amarillo",
      "default": "en un solo lugar."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Botón principal",
      "default": "Explorar catálogo"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Fotografía principal de escritorio"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Fotografía principal de móvil",
      "info": "Recomendamos una foto vertical con espacio para el título en la parte inferior."
    },
    {
      "type": "image_picker",
      "id": "category_image_acabados",
      "label": "Fotografía de pisos y paredes"
    },
    {
      "type": "collection",
      "id": "decokasa_collection",
      "label": "Colección de DECOKASA",
      "info": "Destino en Nuestras marcas. Sin selección se usa la colección inicial si está disponible."
    },
    {
      "type": "image_picker",
      "id": "category_image_cocina",
      "label": "Fotografía de cocina"
    },
    {
      "type": "collection",
      "id": "xion_collection",
      "label": "Colección de Xion",
      "info": "Destino en Nuestras marcas. Sin selección se usa la colección inicial si está disponible."
    },
    {
      "type": "image_picker",
      "id": "category_image_fitness",
      "label": "Fotografía de entrenamiento"
    },
    {
      "type": "collection",
      "id": "biflex_collection",
      "label": "Colección de Biflex",
      "info": "Destino en Nuestras marcas. Sin selección se usa la colección inicial si está disponible."
    },
    {
      "type": "image_picker",
      "id": "category_image_bebes",
      "label": "Fotografía de cuidado del bebé"
    },
    {
      "type": "collection",
      "id": "baby_collection",
      "label": "Colección de Mundo Baby",
      "info": "Destino en Nuestras marcas. Sin selección se usa la colección inicial si está disponible."
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Texto de la franja",
      "default": "Descubre todo lo mejor para tu hogar"
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "WhatsApp de atención (con código de país)",
      "info": "Solo números; por ejemplo, 51987654321. Déjalo vacío para ocultar el botón."
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "Enlace de WhatsApp (wa.me o wa.link)",
      "info": "Alternativa al número. Si usas wa.link, el mensaje debe estar preconfigurado en ese enlace."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje prellenado de WhatsApp",
      "default": "Hola, visité la tienda DECOKASA y quisiera ayuda con un producto o una cotización."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Colección destacada"
    },
    {
      "type": "image_picker",
      "id": "hero_image_0",
      "label": "Fotografía de la diapositiva 1"
    },
    {
      "type": "image_picker",
      "id": "hero_image_1",
      "label": "Fotografía de la diapositiva 2"
    }
  ],
  "presets": [
    {
      "name": "Inicio multimarcas"
    }
  ]
}
{% endschema %}
