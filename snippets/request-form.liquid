{% doc %}
  Renders the simulated purchase request in three steps.
  @param {product} product - Product used to initialize the selection and estimate.
  @param {string} section_id - Section identifier used to label the dialog.
{% enddoc %}
<div class="form-box request-form-box" id="solicitud">
  <h2 id="RequestTitle-{{ section_id }}">Solicita tu compra</h2>
  <p class="request-intro">Completa los pasos para preparar tu solicitud.</p>
  <p class="request-demo-note">Formulario de prueba: usa datos ficticios. La solicitud no se envía.</p>

  <div class="request-progress" aria-label="Progreso de la solicitud">
    <p class="request-progress-count" data-request-progress aria-live="polite">Paso 1 de 3</p>
    <ol class="request-progress-list">
      <li data-request-progress-item aria-current="step"><span>1</span> Pedido</li>
      <li data-request-progress-item><span>2</span> Contacto</li>
      <li data-request-progress-item><span>3</span> Entrega</li>
    </ol>
  </div>

  <form data-request-form data-product-id="{{ product.id }}" data-currency="{{ cart.currency.iso_code | default: shop.currency | default: 'PEN' }}" action="#solicitud" method="post" novalidate>
    <fieldset disabled class="request-fieldset">
      <div class="request-step" data-request-step>
        <h3 tabindex="-1" data-request-step-heading>Revisa tu pedido</h3>
        <p>Esta es la cantidad y el importe estimado de tu selección.</p>
        <div class="form-estimate-summary" data-form-estimate-summary>
          <span class="form-summary-qty">Cantidad seleccionada: <strong data-form-qty>1 unidad</strong></span>
          <span class="form-summary-total">Total estimado: <strong data-form-total>{{ product.selected_or_first_available_variant.price | money_with_currency }}</strong></span>
        </div>
        <div data-request-items></div>
        <label data-request-variant>Presentación<select name="variant_id">{% assign variant = product.selected_or_first_available_variant %}{% if variant != blank %}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-sku="{{ variant.sku | escape }}" data-coverage="{{ variant.metafields.decokasa.coverage_m2.value | default: product.metafields.decokasa.coverage_m2.value }}" selected>{{ variant.title | escape }}</option>{% endif %}</select></label>
        <label data-request-quantity>Cantidad<input name="quantity" type="number" min="1" max="1000000" step="1" value="1" required></label>
      </div>
      <div class="request-step" data-request-step hidden>
        <h3 tabindex="-1" data-request-step-heading>Datos de contacto</h3>
        <p>Indícanos cómo podría contactarte un asesor.</p>
        <label>Nombre<input name="name" autocomplete="name" maxlength="100" required></label>
        <label>Teléfono o WhatsApp<input name="phone" type="tel" autocomplete="tel" minlength="7" maxlength="25" required title="Ingresa tu número de contacto."></label>
        <label>Correo (opcional)<input name="email" type="email" autocomplete="email" maxlength="180"></label>
      </div>
      <div class="request-step" data-request-step hidden>
        <h3 tabindex="-1" data-request-step-heading>Entrega y confirmación</h3>
        <p>Cuéntanos dónde recibirías tu pedido.</p>
        <label>Ciudad o distrito<input name="district" autocomplete="address-level2" maxlength="100" required></label>
        <label>Comentario (opcional)<textarea name="comment" maxlength="1000"></textarea></label>
        <label class="request-consent"><input name="contact_permission" type="checkbox" required><span>Autorizo que un asesor me contacte para atender esta solicitud.</span></label>
      </div>
      <div class="request-actions">
        <button class="request-back" type="button" data-request-back hidden>Anterior</button>
        <button class="request-next" type="button" data-request-next>Siguiente</button>
        <button class="request-submit" type="submit" disabled data-enable-form hidden>Simular solicitud</button>
      </div>
    </fieldset>
    <div data-request-status class="status request-status" tabindex="-1" role="status" hidden></div>
  </form>
  <noscript><p class="error">Activa JavaScript para probar el formulario. No envíes datos reales.</p></noscript>
</div>
