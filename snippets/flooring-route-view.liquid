{% doc %}
  Selects the storefront or advertising view for an SPC or PVC product.
  Only /products/<handle>/landing selects the landing; campaign parameters
  and referrers do not change the view. Keep the landing editable in Shopify.
  @param {object} template - Current product template.
  @param {object} request - Current path and theme editor context.
  @param {product} product - Product whose handle must match the route.
{% enddoc %}
{%- liquid
  assign flooring_view = 'product'
  if template.suffix == 'landing-pvc' or template.suffix == 'landing-spc'
    assign path_segments = request.path | split: '/'
    assign handle_index = path_segments.size | minus: 2
    assign resource_index = path_segments.size | minus: 3
    assign last_segment = path_segments | last
    if last_segment == 'landing' and path_segments[handle_index] == product.handle and path_segments[resource_index] == 'products'
      assign flooring_view = 'landing'
    endif
    if request.design_mode
      assign flooring_view = 'landing'
    endif
  endif
  echo flooring_view
-%}
