<dialog class="interface-cart" data-interface-cart-dialog aria-labelledby="InterfaceCartTitle">
  <div class="interface-cart-head">
    <h2 id="InterfaceCartTitle">Tu carrito</h2>
    <form method="dialog"><button type="submit" aria-label="Cerrar carrito" autofocus>×</button></form>
  </div>
  <p data-cart-empty>Tu carrito está vacío.</p>
  <ol data-cart-items></ol>
  <p data-cart-next hidden>Abre la ficha para completar tu solicitud con un asesor.</p>
</dialog>
<p class="sr-only" role="status" data-interface-status></p>
