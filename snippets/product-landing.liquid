{% doc %}
  Renders the product detail and the selected variant's ordered image gallery.
  @param {product} product - Product whose native data is displayed.
  @param {boolean} [is_demo] - Show the local sample-data notice.
  @param {boolean} [pvc] - Enable the floor coverage calculator.
{% enddoc %}
{{ 'product-detail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-detail.js' | asset_url }}" defer="defer"></script>
{% if product != blank %}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign main_image = current_variant.featured_image | default: product.featured_image %}
  {% assign gallery_images = current_variant.metafields.decokasa.gallery_images.value | where: 'media_type', 'image' %}
  {% assign main_image_id = main_image.id %}
  {% if gallery_images.size > 0 %}
    {% assign main_image_id = gallery_images.first.id %}
  {% else %}
    {% assign gallery_images = product.images %}
  {% endif %}
  <div class="wrap product-page" data-product-page data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-gallery-ratio="{{ section.settings.gallery_ratio | default: 'square' }}" data-image-fit="{{ section.settings.image_fit | default: 'contain' }}">
    <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">Catálogo</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span></nav>
    {% if is_demo %}<p class="product-demo">Vista de muestra · Imágenes ilustrativas y precios ficticios.</p>{% endif %}
    <div class="product-layout">
      <div class="product-gallery" aria-label="Imágenes del producto">
        <div class="product-image-stage" data-gallery-stage>
          {% for gallery_item in gallery_images %}
            {% assign image = gallery_item.preview_image | default: gallery_item %}
            {% assign image_alt = image.alt | default: product.title %}
            <div class="product-image-panel" data-gallery-panel="{{ gallery_item.id }}" {% unless gallery_item.id == main_image_id %}hidden{% endunless %}>
              {% if gallery_item.id == main_image_id %}
                {{ image | image_url: width: 1440 | image_tag: widths: '360, 540, 720, 1080, 1440', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'eager', class: 'product-main-image', alt: image_alt }}
              {% else %}
                {{ image | image_url: width: 1440 | image_tag: widths: '360, 540, 720, 1080, 1440', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'lazy', class: 'product-main-image', alt: image_alt }}
              {% endif %}
            </div>
          {% else %}
            <div class="product-no-image">{% render 'icon', name: 'bag' %}<span>Imagen en preparación</span></div>
          {% endfor %}
          {% if gallery_images.size > 1 %}
            <button class="product-gallery-arrow product-gallery-arrow--previous" type="button" data-gallery-step="-1" aria-label="Imagen anterior" hidden><span aria-hidden="true">&#8249;</span></button>
            <button class="product-gallery-arrow product-gallery-arrow--next" type="button" data-gallery-step="1" aria-label="Imagen siguiente" hidden><span aria-hidden="true">&#8250;</span></button>
          {% endif %}
        </div>
        {% if gallery_images.size > 1 %}
          <div class="product-thumbnails" aria-label="Elegir imagen">
            {% for gallery_item in gallery_images %}
              {% assign image = gallery_item.preview_image | default: gallery_item %}
              {% assign thumb_alt = image.alt | default: product.title %}
              <a class="product-thumbnail" href="{{ image | image_url: width: 1440 }}" data-gallery-choice="{{ gallery_item.id }}" aria-label="Ver imagen {{ forloop.index }}: {{ thumb_alt | escape }}" {% if gallery_item.id == main_image_id %}aria-current="true"{% endif %}>
                {{ image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '80px', loading: 'lazy', alt: '' }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
        <p class="sr-only" data-gallery-status role="status"></p>
      </div>
      <div class="product-summary">
        <div class="product-purchase-panel" data-purchase-panel>
        <div class="product-purchase-content" data-purchase-content tabindex="0" aria-label="Opciones y detalles de compra">
        {% if section.settings.show_vendor != false and product.vendor != blank %}<p class="eyebrow product-vendor">{{ product.vendor | escape }}</p>{% endif %}
        <h1>{{ product.title | escape }}</h1>
        <div class="product-price-row">
          {% if section.settings.show_price != false and current_variant != blank %}
            <span class="product-price" data-product-price data-cents="{{ current_variant.price }}">{{ current_variant.price | money_with_currency }}</span>
            {% if section.settings.show_compare_price != false and current_variant.compare_at_price > current_variant.price %}<s class="product-compare-price">{{ current_variant.compare_at_price | money_with_currency }}</s>{% endif %}
          {% else %}<span class="product-price">Precio a consultar</span>{% endif %}
        </div>
        <p class="product-price-note">{{ section.settings.price_note | default: 'El asesor confirmará el importe final y la entrega.' | escape }}</p>
        {% unless product.has_only_default_variant %}
          <div class="product-options" aria-label="Presentaciones">
            {% for option in product.options_with_values %}
              {% assign current_option = option %}
              <div class="product-option-group" role="group" aria-labelledby="Option-{{ section.id }}-{{ option.position }}">
                <p id="Option-{{ section.id }}-{{ option.position }}" class="product-option-label">{{ option.name | escape }}: <strong>{{ option.selected_value | escape }}</strong></p>
                <div class="product-option-values">
                  {% for value in option.values %}
                    {% capture option_ids %}{% for other_option in product.options_with_values %}{% if other_option.position == current_option.position %}{{ value.id }}{% else %}{% for selected_value in other_option.values %}{% if selected_value.selected %}{{ selected_value.id }}{% endif %}{% endfor %}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}
                    {% assign option_url = value.product_url | default: product.url %}
                    <a class="product-option" href="{{ option_url }}?option_values={{ option_ids | strip }}" data-option-link {% if value.selected %}aria-current="true"{% endif %}>
                      {% if value.swatch.image != blank %}{{ value.swatch.image | image_url: width: 100 | image_tag: widths: '50, 100', sizes: '44px', loading: 'lazy', alt: '' }}
                      {% elsif value.swatch.color != blank %}<span class="product-swatch" style="background-color: {{ value.swatch.color }}" aria-hidden="true"></span>
                      {% elsif value.variant.featured_image != blank %}{{ value.variant.featured_image | image_url: width: 100 | image_tag: widths: '50, 100', sizes: '44px', loading: 'lazy', alt: '' }}{% endif %}
                      <span>{{ value.name | escape }}</span>
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}
        <p class="product-availability">{% render 'icon', name: 'headphones' %}<span><strong>Disponibilidad a confirmar</strong><small>Un asesor te ayuda con tu compra.</small></span></p>
        {% if pvc or product.metafields.decokasa.coverage_m2.value != blank or current_variant.metafields.decokasa.coverage_m2.value != blank %}{% render 'pvc-calculator' %}{% endif %}
        {% assign multiple_request = false %}
        {% unless product.has_only_default_variant or pvc or product.metafields.decokasa.coverage_m2.value != blank or current_variant.metafields.decokasa.coverage_m2.value != blank %}{% assign multiple_request = true %}{% endunless %}
        {% if multiple_request %}<p class="request-builder-help">Elige una presentación y su cantidad. Agrégala a tu solicitud y repite con los otros colores que quieras.</p>{% endif %}
        <div class="product-purchase" data-purchase-controls>
          <div class="product-quantity"><button type="button" data-quantity-step="-1" aria-label="Disminuir cantidad">−</button><label class="sr-only" for="Quantity-{{ section.id }}">Cantidad</label><input id="Quantity-{{ section.id }}" data-product-quantity type="number" min="1" max="1000000" step="1" value="1" inputmode="numeric"><button type="button" data-quantity-step="1" aria-label="Aumentar cantidad">+</button></div>
          {% if multiple_request %}
          <button type="button" class="button yellow product-cta" data-add-request {% if current_variant == blank %}disabled{% endif %}>Agregar a mi solicitud</button>
          {% else %}
          <a class="button yellow product-cta" href="#solicitud" data-open-request {% if current_variant == blank %}aria-disabled="true"{% endif %}>{{ section.settings.cta_label | default: 'Solicitar compra' | escape }}</a>
          {% endif %}
        </div>
        {% if multiple_request %}
        <details class="request-builder" data-request-builder open>
          <summary><strong>Tu solicitud</strong><span data-request-count>0 presentaciones</span></summary>
          <p data-request-empty>Aún no agregaste una presentación.</p>
          <ul class="request-lines" data-request-lines></ul>
        </details>
        <p class="request-builder-status" data-request-builder-status role="status"></p>
        {% endif %}
        {% assign goal_cents = product.price_max | times: 1.8 | round %}
        {% if goal_cents > 0 %}
        <div class="reward-goal-card hierarchy-top" data-reward-goal data-threshold="{{ goal_cents }}">
          <div class="reward-goal-badge">
            <div class="reward-badge-left">
              <span class="reward-badge-dot"></span>
              <span class="reward-badge-title">META DE OBJETIVO · REGALO ESPECIAL</span>
            </div>
            <button type="button" class="reward-badge-action reward-badge-pill" data-reward-modal-open aria-haspopup="dialog" aria-expanded="false" title="Ver detalles y beneficios del regalo especial">
              <svg class="reward-gift-mini" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13"/><path d="M19 12H5"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.5 4.5 0 0 1 12 7.5a4.5 4.5 0 0 1 4.5-4.5 2.5 2.5 0 0 1 0 5z"/></svg>
              <span class="reward-action-text" data-reward-action-text>Meta {{ goal_cents | money_with_currency }} · Ver regalo</span>
              <svg class="reward-action-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
          <div class="reward-goal-header">
            <div class="reward-goal-icon" data-reward-icon>🎁</div>
            <div class="reward-goal-info">
              <span class="reward-goal-title" data-reward-title>¡Agrega <strong data-reward-remaining>{{ goal_cents | money_with_currency }}</strong> para desbloquear tu <strong>Regalo Especial</strong>!</span>
              <span class="reward-goal-subtext" data-reward-subtext>Al alcanzar un monto de gasto de {{ goal_cents | money_with_currency }} recibes un regalo especial con tu pedido.</span>
            </div>
          </div>
          <div class="reward-progress-track" role="progressbar" aria-label="Progreso hacia regalo especial" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="reward-progress-fill" data-reward-fill style="width: 0%;"></div>
          </div>
          <div class="reward-goal-footer">
            <span class="reward-current-label">Total estimado: <strong class="reward-current" data-reward-current>{{ current_variant.price | money_with_currency }}</strong></span>
            <span class="reward-percent" data-reward-percent>0% de la meta</span>
          </div>
        </div>
        <dialog class="reward-modal-dialog" data-reward-modal aria-labelledby="RewardModalTitle-{{ section.id }}">
          <div class="reward-modal-backdrop" data-reward-modal-close></div>
          <div class="reward-modal-card">
            <div class="reward-modal-header">
              <div class="reward-modal-badge">
                <span>🎁 Beneficio Exclusivo</span>
                <span>Desde {{ goal_cents | money_with_currency }}</span>
              </div>
              <button type="button" class="reward-modal-close" data-reward-modal-close aria-label="Cerrar modal">&times;</button>
            </div>
            <h2 id="RewardModalTitle-{{ section.id }}" class="reward-modal-title">Regalo Especial por tu compra en Decokasa</h2>
            <p class="reward-modal-lead">Por cada solicitud de compra que alcance o supere los <strong>{{ goal_cents | money_with_currency }}</strong>, nuestro equipo incluye un regalo especial de cortesía en tu pedido.</p>
            <div class="reward-modal-perks">
              <div class="reward-perk">
                <span class="reward-perk-icon">🎁</span>
                <div>
                  <strong>Obsequio premium de cortesía</strong>
                  <p>Accesorios de instalación, complementos de acabado o detalle exclusivo seleccionado para tu categoría de producto.</p>
                </div>
              </div>
              <div class="reward-perk">
                <span class="reward-perk-icon">⚡</span>
                <div>
                  <strong>Activación automática sin cupones</strong>
                  <p>El total estimado de tu ficha calcula tu progreso al instante. Al enviar tu solicitud, el asesor valida tu regalo en Odoo.</p>
                </div>
              </div>
              <div class="reward-perk">
                <span class="reward-perk-icon">🏷️</span>
                <div>
                  <strong>Una meta para este producto</strong>
                  <p>La meta es un 80% más que el precio de una unidad. Si hay varios precios, se toma la presentación más cara; cambiar de color o modelo no cambia la meta.</p>
                </div>
              </div>
            </div>
            <div class="reward-modal-footer">
              <button type="button" class="button yellow reward-modal-btn" data-reward-modal-close>¡Entendido! Continuar cotizando</button>
            </div>
          </div>
        </dialog>
        {% endif %}
        </div>
        <div class="product-purchase-footer">
        <div class="product-estimate-card" data-estimated-bar>
          <div class="estimate-line">
            <span class="estimate-title" data-estimated-label>Monto estimado a pagar:</span>
            <strong class="estimate-amount" data-estimated-amount>{{ current_variant.price | money_with_currency }}</strong>
          </div>
          <div class="estimate-breakdown" data-estimated-breakdown>1 unidad × {{ current_variant.price | money_with_currency }}</div>
        </div>
        {% if multiple_request %}<a class="button yellow request-continue" href="#solicitud" data-open-request aria-disabled="true">{{ section.settings.cta_label | default: 'Solicitar compra' | escape }}</a>{% endif %}
        {% if current_variant == blank %}<p class="error">Esta combinación no existe. Elige otra presentación.</p>{% endif %}
        {% if section.settings.show_sku != false %}<p class="product-sku">SKU: <span data-sku>{{ current_variant.sku | default: 'Pendiente' | escape }}</span></p>{% endif %}
        </div>
        </div>
        <details class="product-request" data-request-details><summary>Completar solicitud con un asesor</summary>{% render 'request-form', product: product %}</details>
        <p class="product-selection-status" data-selection-status role="status" tabindex="-1"></p>
      </div>
    </div>
    <div class="product-information-container">
        {% if section.settings.show_description != false and product.description != blank %}<details class="product-information" open><summary>Acerca del producto</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
        {% for block in section.blocks %}<details class="product-information" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endfor %}
    </div>
  </div>
{% else %}<section class="wrap section"><h1>Ficha en preparación</h1><p>Selecciona un producto en el editor del tema para ver su ficha.</p></section>{% endif %}
