{{ 'product-detail.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-detail.js' | asset_url }}" defer="defer"></script>
{% if product != blank %}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign main_image = current_variant.featured_image | default: product.featured_image %}
  <div class="wrap product-page" data-product-page data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-gallery-ratio="{{ section.settings.gallery_ratio | default: 'square' }}" data-image-fit="{{ section.settings.image_fit | default: 'contain' }}">
    <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">Catálogo</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span></nav>
    {% if is_demo %}<p class="product-demo">Vista de muestra · Imágenes ilustrativas y precios ficticios.</p>{% endif %}
    <div class="product-layout">
      <div class="product-gallery" aria-label="Imágenes del producto">
        <div class="product-image-stage">
          {% for image in product.images %}
            {% assign image_alt = image.alt | default: product.title %}
            <div class="product-image-panel" data-gallery-panel="{{ image.id }}" {% unless image.id == main_image.id %}hidden{% endunless %}>
              {% if image.id == main_image.id %}
                {{ image | image_url: width: 1440 | image_tag: widths: '360, 540, 720, 1080, 1440', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'eager', class: 'product-main-image', alt: image_alt }}
              {% else %}
                {{ image | image_url: width: 1440 | image_tag: widths: '360, 540, 720, 1080, 1440', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'lazy', class: 'product-main-image', alt: image_alt }}
              {% endif %}
            </div>
          {% else %}
            <div class="product-no-image">{% render 'icon', name: 'bag' %}<span>Imagen en preparación</span></div>
          {% endfor %}
        </div>
        {% if product.images.size > 1 %}
          <div class="product-thumbnails" aria-label="Elegir imagen">
            {% for image in product.images %}
              {% assign thumb_alt = image.alt | default: product.title %}
              <a class="product-thumbnail" href="{{ image | image_url: width: 1440 }}" data-gallery-choice="{{ image.id }}" aria-label="Ver imagen {{ forloop.index }}: {{ thumb_alt | escape }}" {% if image.id == main_image.id %}aria-current="true"{% endif %}>
                {{ image | image_url: width: 180 | image_tag: widths: '90, 180', sizes: '80px', loading: 'lazy', alt: '' }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
        <p class="sr-only" data-gallery-status role="status"></p>
      </div>
      <div class="product-summary">
        {% if section.settings.show_vendor != false and product.vendor != blank %}<p class="eyebrow product-vendor">{{ product.vendor | escape }}</p>{% endif %}
        <h1>{{ product.title | escape }}</h1>
        <div class="product-price-row">
          {% if section.settings.show_price != false and current_variant != blank %}
            <span class="product-price" data-product-price data-cents="{{ current_variant.price }}">{{ current_variant.price | money_with_currency }}</span>
            {% if section.settings.show_compare_price != false and current_variant.compare_at_price > current_variant.price %}<s class="product-compare-price">{{ current_variant.compare_at_price | money_with_currency }}</s>{% endif %}
          {% else %}<span class="product-price">Precio a consultar</span>{% endif %}
        </div>
        <p class="product-price-note">{{ section.settings.price_note | default: 'El asesor confirmará el importe final y la entrega.' | escape }}</p>
        {% unless product.has_only_default_variant %}
          <div class="product-options" aria-label="Presentaciones">
            {% for option in product.options_with_values %}
              {% assign current_option = option %}
              <div class="product-option-group" role="group" aria-labelledby="Option-{{ section.id }}-{{ option.position }}">
                <p id="Option-{{ section.id }}-{{ option.position }}" class="product-option-label">{{ option.name | escape }}: <strong>{{ option.selected_value | escape }}</strong></p>
                <div class="product-option-values">
                  {% for value in option.values %}
                    {% capture option_ids %}{% for other_option in product.options_with_values %}{% if other_option.position == current_option.position %}{{ value.id }}{% else %}{% for selected_value in other_option.values %}{% if selected_value.selected %}{{ selected_value.id }}{% endif %}{% endfor %}{% endif %}{% unless forloop.last %},{% endunless %}{% endfor %}{% endcapture %}
                    {% assign option_url = value.product_url | default: product.url %}
                    <a class="product-option" href="{{ option_url }}?option_values={{ option_ids | strip }}" data-option-link {% if value.selected %}aria-current="true"{% endif %}>
                      {% if value.swatch.image != blank %}{{ value.swatch.image | image_url: width: 100 | image_tag: widths: '50, 100', sizes: '44px', loading: 'lazy', alt: '' }}
                      {% elsif value.swatch.color != blank %}<span class="product-swatch" style="background-color: {{ value.swatch.color }}" aria-hidden="true"></span>
                      {% elsif value.variant.featured_image != blank %}{{ value.variant.featured_image | image_url: width: 100 | image_tag: widths: '50, 100', sizes: '44px', loading: 'lazy', alt: '' }}{% endif %}
                      <span>{{ value.name | escape }}</span>
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}
        <p class="product-availability">{% render 'icon', name: 'headphones' %}<span><strong>Disponibilidad a confirmar</strong><small>Un asesor te ayuda con tu compra.</small></span></p>
        {% if pvc or product.metafields.decokasa.coverage_m2.value != blank or current_variant.metafields.decokasa.coverage_m2.value != blank %}{% render 'pvc-calculator' %}{% endif %}
        <div class="product-purchase" data-purchase-controls>
          <div class="product-quantity"><button type="button" data-quantity-step="-1" aria-label="Disminuir cantidad">−</button><label class="sr-only" for="Quantity-{{ section.id }}">Cantidad</label><input id="Quantity-{{ section.id }}" data-product-quantity type="number" min="1" max="1000000" step="1" value="1" inputmode="numeric"><button type="button" data-quantity-step="1" aria-label="Aumentar cantidad">+</button></div>
          <a class="button yellow product-cta" href="#solicitud" data-open-request {% if current_variant == blank %}aria-disabled="true"{% endif %}>{{ section.settings.cta_label | default: 'Solicitar compra' | escape }}</a>
        </div>
        <div class="product-estimate-card" data-estimated-bar>
          <div class="estimate-line">
            <span class="estimate-title">Monto estimado:</span>
            <strong class="estimate-amount" data-estimated-amount>{{ current_variant.price | money_with_currency }}</strong>
          </div>
          <div class="estimate-breakdown" data-estimated-breakdown>1 unidad × {{ current_variant.price | money_with_currency }}</div>
        </div>
        {% if current_variant == blank %}<p class="error">Esta combinación no existe. Elige otra presentación.</p>{% endif %}
        {% if section.settings.show_sku != false %}<p class="product-sku">SKU: <span data-sku>{{ current_variant.sku | default: 'Pendiente' | escape }}</span></p>{% endif %}
        <details class="product-request" data-request-details><summary>Completar solicitud con un asesor</summary>{% render 'request-form', product: product %}</details>
        {% if section.settings.show_description != false and product.description != blank %}<details class="product-information" open><summary>Acerca del producto</summary><div class="rte">{{ product.description }}</div></details>{% endif %}
        {% for block in section.blocks %}<details class="product-information" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endfor %}
        <p class="product-selection-status" data-selection-status role="status" tabindex="-1"></p>
      </div>
    </div>
  </div>
{% else %}<section class="wrap section"><h1>Ficha en preparación</h1><p>Selecciona un producto en el editor del tema para ver su ficha.</p></section>{% endif %}
