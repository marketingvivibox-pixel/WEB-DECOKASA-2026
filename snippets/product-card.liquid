{% doc %}
  Renders a catalog card and, for regular product pages, its real color variants.
  @param {product} product - Product to display.
  @param {boolean} [demo] - Render a local illustration and demo filter attributes.
{% enddoc %}
{% assign landing_url = product.metafields.decokasa.landing_url.value | default: product.url %}
{% assign color_option = nil %}
{% for option in product.options_with_values %}
  {% assign option_name = option.name | strip | downcase %}
  {% if option_name == 'color' or option_name == 'colores' or option_name == 'colour' %}
    {% if option.values.size > 1 and landing_url == product.url %}
      {% assign color_option = option %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign card_image = product.featured_image %}
{% assign card_image_reference = false %}
{% assign card_url = landing_url %}
{% if color_option != nil and current_variant != nil %}
  {% assign card_image = current_variant.featured_image %}
  {% if card_image == blank and product.featured_image != blank %}
    {% assign card_image = product.featured_image %}
    {% assign card_image_reference = true %}
  {% endif %}
  {% assign card_url = landing_url | append: '?variant=' | append: current_variant.id %}
{% endif %}
{% assign quick_add = false %}
{% if landing_url == product.url and product.metafields.decokasa.coverage_m2.value == blank %}
  {% if product.has_only_default_variant or product.options_with_values.size == 1 and color_option != nil %}{% assign quick_add = true %}{% endif %}
{% endif %}
<article class="card catalog-card" data-product-handle="{{ product.handle | escape }}" data-interface-title="{{ product.title | escape }}" data-motion{% if demo %} data-card data-brand="{{ product.vendor | escape }}" data-category="{{ product.type | escape }}" data-title="{{ product.title | escape }}"{% endif %}>
  <a class="catalog-card-media" href="{{ card_url | escape }}" aria-label="Ver {{ product.title | escape }}" data-card-link>
    {% if demo %}
      {% render 'catalog-art', handle: product.handle %}<span class="catalog-sample">Ilustración de muestra</span>
    {% elsif card_image %}
      {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 1200px) 25vw, (min-width: 900px) 33vw, 50vw', class: 'catalog-product-photo' }}
    {% else %}
      <img class="catalog-product-photo" alt="" width="800" height="800" hidden>
    {% endif %}
    {% unless demo %}<div class="catalog-image-pending" data-card-image-pending{% if card_image %} hidden{% endif %}>{% render 'icon', name: 'box' %}<span>Imagen pendiente</span></div><span class="catalog-sample" data-card-image-reference{% unless card_image_reference %} hidden{% endunless %}>Imagen referencial</span>{% endunless %}
  </a>
  <div class="card-body">
    <span class="tag">{{ product.vendor | escape }}</span>
    <p class="catalog-card-category">{{ product.type | escape }}</p>
    <h3><a href="{{ card_url | escape }}" data-card-link>{{ product.title | escape }}</a></h3>
    <div class="catalog-card-price">
      <strong data-card-price>{% if current_variant.price > 0 %}{{ current_variant.price | money_with_currency }}{% else %}Precio a consultar{% endif %}</strong>
      <s data-card-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money_with_currency }}{% endif %}</s>
    </div>
    {% if color_option != nil and current_variant != nil %}
      {% assign color_index = color_option.position | minus: 1 %}
      <div class="catalog-colors">
        <p class="catalog-colors-label" data-card-color-label role="status">Color: <strong>{{ current_variant.options[color_index] | escape }}</strong>{% unless current_variant.available %} <span>(no disponible)</span>{% endunless %}</p>
        <div class="catalog-color-options" role="group" aria-label="Colores de {{ product.title | escape }}">
          {% for value in color_option.values %}
            {% assign color_variant = value.variant %}
            {% if value.name == current_variant.options[color_index] %}
              {% assign color_variant = current_variant %}
            {% elsif color_variant == nil or color_variant.available == false %}
              {% for candidate in product.variants %}
                {% if candidate.options[color_index] == value.name %}
                  {% if color_variant == nil %}{% assign color_variant = candidate %}{% endif %}
                  {% if candidate.available %}{% assign color_variant = candidate %}{% break %}{% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
            {% if color_variant != nil %}
              {% assign color_key = value.name | handleize %}
              {% assign color_hex = '' %}
              {% case color_key %}
                {% when 'gris-claro' %}
                  {% assign color_hex = settings.swatch_gris_claro | default: '#d4d4d8' %}
                {% when 'gris-oscuro' %}
                  {% assign color_hex = settings.swatch_gris_oscuro | default: '#4b5563' %}
                {% when 'azul-marino' %}
                  {% assign color_hex = settings.swatch_azul_marino | default: '#1e3a8a' %}
                {% when 'verde-militar', 'verde-oliva' %}
                  {% assign color_hex = settings.swatch_verde_militar | default: '#4d5d43' %}
                {% when 'negro' %}{% assign color_hex = '#1c1c1c' %}
                {% when 'blanco' %}{% assign color_hex = '#ffffff' %}
                {% when 'marron', 'cafe' %}{% assign color_hex = settings.swatch_marron | default: '#79513c' %}
                {% when 'gris' %}{% assign color_hex = '#909499' %}
                {% when 'azul' %}{% assign color_hex = '#285fa7' %}
                {% when 'rojo' %}{% assign color_hex = '#c62e32' %}
                {% when 'verde' %}{% assign color_hex = '#598541' %}
                {% when 'beige', 'crema' %}{% assign color_hex = settings.swatch_beige | default: '#dfcfaf' %}
                {% when 'amarillo' %}{% assign color_hex = '#e7c836' %}
                {% when 'naranja' %}{% assign color_hex = '#e5792e' %}
                {% when 'rosa', 'rosado' %}{% assign color_hex = '#e1a2b3' %}
                {% when 'morado', 'violeta' %}{% assign color_hex = '#80619b' %}
                {% when 'plata' %}{% assign color_hex = '#bdc1c4' %}
                {% when 'dorado' %}{% assign color_hex = '#c8a25c' %}
              {% endcase %}
              {% assign swatch_config = custom_color_swatches | default: section.settings.custom_color_swatches | default: settings.custom_color_swatches %}
              {% if swatch_config != blank %}
                {% assign custom_rules = swatch_config | newline_to_br | replace: '<br />', '||' | split: '||' %}
                {% for rule in custom_rules %}
                  {% assign rule_clean = rule | strip %}
                  {% if rule_clean != blank %}
                    {% assign separator = '' %}
                    {% if rule_clean contains '=' %}{% assign separator = '=' %}
                    {% elsif rule_clean contains ':' %}{% assign separator = ':' %}{% endif %}
                    {% if separator != '' %}
                      {% assign rule_parts = rule_clean | split: separator %}
                      {% assign rule_name = rule_parts[0] | strip_newlines | strip | handleize %}
                      {% if rule_name == color_key %}
                        {% assign color_hex = rule_parts[1] | strip_newlines | strip %}
                        {% break %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% if color_hex == blank %}
                {% if color_key contains 'gris' %}
                  {% assign color_hex = '#909499' %}
                {% elsif color_key contains 'azul' %}
                  {% assign color_hex = '#285fa7' %}
                {% elsif color_key contains 'verde' %}
                  {% assign color_hex = '#598541' %}
                {% elsif color_key contains 'rojo' %}
                  {% assign color_hex = '#c62e32' %}
                {% elsif color_key contains 'negro' %}
                  {% assign color_hex = '#1c1c1c' %}
                {% elsif color_key contains 'blanco' %}
                  {% assign color_hex = '#ffffff' %}
                {% elsif color_key contains 'amarillo' %}
                  {% assign color_hex = '#e7c836' %}
                {% elsif color_key contains 'naranja' %}
                  {% assign color_hex = '#e5792e' %}
                {% elsif color_key contains 'rosa' or color_key contains 'rosado' %}
                  {% assign color_hex = '#e1a2b3' %}
                {% elsif color_key contains 'morado' or color_key contains 'violeta' %}
                  {% assign color_hex = '#80619b' %}
                {% elsif color_key contains 'beige' or color_key contains 'crema' %}
                  {% assign color_hex = '#dfcfaf' %}
                {% elsif color_key contains 'marron' or color_key contains 'cafe' %}
                  {% assign color_hex = '#79513c' %}
                {% endif %}
              {% endif %}
              {% if value.swatch.color != blank %}{% capture color_hex %}rgb({{ value.swatch.color.rgb }}){% endcapture %}{% endif %}
              {% assign variant_image = color_variant.featured_image %}
              {% assign image_reference = false %}
              {% if variant_image == blank and product.featured_image != blank %}
                {% assign variant_image = product.featured_image %}
                {% assign image_reference = true %}
              {% endif %}
              {% assign variant_url = landing_url | append: '?variant=' | append: color_variant.id %}
              <a class="catalog-color-choice{% if color_hex == blank and value.swatch.image == blank %} catalog-color-choice--text{% endif %}" href="{{ variant_url | escape }}" data-card-color data-color-name="{{ value.name | escape }}" data-color-available="{{ color_variant.available }}" data-color-cart="{% if color_variant.available and color_variant.metafields.decokasa.coverage_m2.value == blank %}true{% else %}false{% endif %}" data-color-variant="{{ color_variant.id }}" data-color-price="{% if color_variant.price > 0 %}{{ color_variant.price | money_with_currency | escape }}{% else %}Precio a consultar{% endif %}" data-color-compare="{% if color_variant.compare_at_price > color_variant.price %}{{ color_variant.compare_at_price | money_with_currency | escape }}{% endif %}" data-color-image="{% if variant_image %}{{ variant_image | image_url: width: 800 | escape }}{% endif %}" data-color-image-reference="{{ image_reference }}" data-color-image-alt="{{ product.title | escape }} - {% if image_reference %}Imagen referencial{% else %}{{ value.name | escape }}{% endif %}" aria-label="Ver color {{ value.name | escape }}{% unless color_variant.available %}, no disponible{% endunless %}" title="{{ value.name | escape }}{% unless color_variant.available %} (no disponible){% endunless %}"{% if color_variant.id == current_variant.id %} aria-current="true"{% endif %}>
                {% if color_hex != blank or value.swatch.image != blank %}
                  <span class="catalog-color-dot"{% if color_hex != blank %} style="background-color: {{ color_hex | escape }}"{% endif %}>{% if value.swatch.image != blank %}{{ value.swatch.image | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
                {% else %}<span>{{ value.name | escape }}</span>{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
    <div class="interface-card-actions">
    <a class="button interface-card-action" href="{{ card_url | escape }}" data-card-link{% if quick_add %} data-interface-card-add data-variant="{{ current_variant.id }}" data-available="{% if current_variant.available and current_variant.metafields.decokasa.coverage_m2.value == blank %}true{% else %}false{% endif %}" aria-label="Ver {{ product.title | escape }}"{% endif %}>{% render 'icon', name: 'bag' %}<span data-card-action-label>Ver {% if quick_add %}ficha{% else %}producto{% endif %}</span></a>
    {% render 'storefront-favorite', product: product %}
    </div>
  </div>
</article>
