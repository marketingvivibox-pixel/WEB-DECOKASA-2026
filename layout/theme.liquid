{%- liquid
  assign custom_landing = false
  if template.suffix == 'landing-spc' or template.suffix == 'landing-pvc'
    assign custom_landing = true
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title | escape }} · DECOKASA</title>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" sizes="128x128" href="{{ 'favicon.png' | asset_url }}">
    {{ content_for_header }}
    {% unless custom_landing %}
      {{ 'decokasa.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'decokasa.js' | asset_url }}" defer></script>
    {% endunless %}
  </head>
  <body{% if template.suffix == 'landing-spc' %} class="spc-layout"{% elsif template.suffix == 'landing-pvc' %} class="pvc-layout"{% endif %}>
    {% unless custom_landing %}{% section 'header' %}{% endunless %}
    <main id="main">{{ content_for_layout }}</main>
    {% unless custom_landing %}
      <div class="demo">Tienda en preparación · Los formularios son de prueba y todavía no envían solicitudes.</div>
      {% section 'footer' %}
    {% endunless %}
  </body>
</html>
